---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

type Props = {
  projects: CollectionEntry<"projects">[];
  /** 首屏显示几行（= 几个项目），其余等滚到底部附近再展开 */
  initialRows?: number;
};

const { projects, initialRows = 5 } = Astro.props;

type Row = {
  dir: "ltr" | "rtl";
  items: CollectionEntry<"projects">[];
};

/**
 * 一个项目一行：折返连线在行末，项目框贴在相反的一端。
 * 第 1 行：项目在左、竖线在右；第 2 行：竖线在左、项目在右……
 * 这样两条横轴 + 折返竖线首尾相连，是一条不断开的时间轴。
 */
const rows: Row[] = projects.map((project, index) => ({
  dir: index % 2 === 0 ? "ltr" : "rtl",
  items: [project],
}));

const contents = await Promise.all(
  projects.map(async project => ({
    slug: project.id,
    Content: (await render(project)).Content,
  }))
);
const contentMap = new Map(contents.map(item => [item.slug, item.Content]));
---

<section class="projects" data-projects>
  <ol class="projects-track">
    {
      rows.map((row, rowIndex) => (
        <li
          class="projects-row"
          data-dir={row.dir}
          data-hidden={rowIndex >= initialRows ? "true" : "false"}
        >
          <span class="projects-rails" aria-hidden="true" />
          <div class="projects-boxes">
            {row.items.map(project => {
              const Content = contentMap.get(project.id);
              const { name, start, end, role, summary, stack, repos } =
                project.data;
              const period = end ? `${start} – ${end}` : `${start} 起`;
              const primary = repos[0];

              return (
                <article class="project-box" data-project={project.id}>
                  <p class="project-period">{period}</p>
                  <h2 class="project-name">
                    {primary ? (
                      <a
                        href={primary.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </h2>
                  <p class="project-summary">{summary}</p>

                  <div class="project-pop">
                    <p class="project-pop-role">{role}</p>
                    <div class="project-pop-body">{Content && <Content />}</div>
                    {stack.length > 0 && (
                      <ul class="project-stack">
                        {stack.map(item => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    )}
                    {repos.length > 0 && (
                      <ul class="project-links">
                        {repos.map(repo => (
                          <li>
                            <a
                              href={repo.url}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {repo.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </li>
      ))
    }
  </ol>

  <div class="projects-sentinel" data-projects-sentinel aria-hidden="true">
  </div>
</section>

<style>
  .projects {
    --pr-gap: 2.5rem;
    /* 轴线宽度交给外层 .app-layout（与页头/页脚同一栏） */
    --pr-inset: 0rem;
    --pr-flow: 0.35;
    --pr-flow-hot: 0.8;
    --pr-flow-color: var(--color-accent);
    position: relative;
    padding-block: 1.5rem 3rem;
  }

  :global([data-theme="dark"]) .projects {
    --pr-flow: 0.5;
    --pr-flow-hot: 1;
    --pr-flow-color: color-mix(in srgb, var(--color-accent) 60%, #fff);
  }

  .projects-track {
    display: flex;
    flex-direction: column;
    gap: var(--pr-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projects-row {
    position: relative;
    padding-inline: var(--pr-inset);
  }

  .projects-row[data-hidden="true"] {
    display: none;
  }

  /* 两条水平轴线 + 折返处的竖线，合起来是一条连续的时间轴 */
  .projects-rails {
    position: absolute;
    inset-block: 0;
    inset-inline: var(--pr-inset);
    border-block: 1px solid var(--color-border);
    transition: border-color 0.2s ease;
  }

  .projects-rails::before,
  .projects-rails::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    block-size: 3px;
    pointer-events: none;
    opacity: var(--pr-flow);
    transition: opacity 0.4s ease;
    background-size: 28% 100%;
    background-repeat: no-repeat;
  }

  .projects-rails::before {
    inset-block-start: -2px;
    background-image: linear-gradient(
      90deg,
      transparent,
      var(--pr-flow-color),
      transparent
    );
    animation: pr-flow 9s linear infinite;
  }

  .projects-rails::after {
    inset-block-end: -2px;
    background-image: linear-gradient(
      270deg,
      transparent,
      var(--pr-flow-color),
      transparent
    );
    animation: pr-flow 9s linear infinite reverse;
  }

  @keyframes pr-flow {
    from {
      background-position: -30% 0;
    }
    to {
      background-position: 130% 0;
    }
  }

  /* 折返竖线：接到下一行的起点 */
  .projects-fallback-connector {
    display: none;
  }

  .projects-row:not(:last-child)::after {
    content: "";
    position: absolute;
    inset-block-start: 100%;
    block-size: var(--pr-gap);
    inline-size: 1px;
    background: var(--color-border);
  }

  .projects-row[data-dir="ltr"]:not(:last-child)::after {
    inset-inline-end: var(--pr-inset);
  }

  .projects-row[data-dir="rtl"]:not(:last-child)::after {
    inset-inline-start: var(--pr-inset);
  }

  /* 每行一个项目：占一半宽度，奇数行贴左、偶数行贴右 */
  .projects-boxes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding-block: 1.5rem;
  }

  .projects-row[data-dir="rtl"] .project-box {
    grid-column: 2 / -1;
  }

  .project-box {
    position: relative;
    padding: 0.75rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 3px;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .project-box:hover,
  .project-box:focus-within {
    z-index: 30;
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    transform: translateY(-2px);
  }

  .projects-row:has(.project-box:hover) .projects-rails,
  .projects-row:has(.project-box:focus-within) .projects-rails {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  .projects-row:has(.project-box:hover) .projects-rails::before,
  .projects-row:has(.project-box:hover) .projects-rails::after,
  .projects-row:has(.project-box:focus-within) .projects-rails::before,
  .projects-row:has(.project-box:focus-within) .projects-rails::after {
    opacity: var(--pr-flow-hot);
    transition-duration: 0.15s;
  }

  .project-period {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-muted-foreground);
  }

  .project-name {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .project-name a {
    color: inherit;
    text-decoration: none;
  }

  .project-name a:hover {
    color: var(--color-accent);
  }

  .project-summary {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  /* hover / 键盘聚焦时弹出详情卡片（绝对定位，不推挤布局） */
  .project-pop {
    position: absolute;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-start: 0;
    z-index: 40;
    inline-size: min(26rem, 80vw);
    max-block-size: 60svh;
    overflow: auto;
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 4px;
    background: var(--color-background);
    box-shadow: 0 12px 32px rgb(0 0 0 / 18%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }

  .project-box:hover .project-pop,
  .project-box:focus-within .project-pop {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .project-pop-role {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .project-pop-body {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-muted-foreground);
  }

  .project-pop-body :global(h2),
  .project-pop-body :global(h3) {
    margin: 0.6rem 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .project-pop-body :global(p) {
    margin: 0.25rem 0 0;
  }

  .project-pop-body :global(ul) {
    margin: 0.25rem 0 0;
    padding-inline-start: 1.05rem;
    list-style: revert;
  }

  .project-pop-body :global(code) {
    background: var(--color-muted);
    border-radius: 2px;
    padding: 0 0.2rem;
  }

  .project-stack,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }

  .project-stack li {
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0 0.3rem;
    color: var(--color-muted-foreground);
  }

  .project-links a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 3px;
  }

  /* 首列弹窗贴左、末列贴右，避免超出可视区 */
  .project-box:first-child .project-pop {
    inset-inline-start: 0;
  }

  .project-box:last-child .project-pop {
    inset-inline-start: auto;
    inset-inline-end: 0;
  }

  .projects-sentinel {
    block-size: 1px;
  }

  /* 顶部 / 底部渐隐，与首页一致 */
  .projects::before,
  .projects::after {
    content: "";
    position: fixed;
    inset-inline: 0;
    block-size: 2.5rem;
    z-index: 20;
    pointer-events: none;
  }

  .projects::before {
    inset-block-start: 0;
    background: linear-gradient(
      to bottom,
      var(--color-background),
      transparent
    );
  }

  .projects::after {
    inset-block-end: 0;
    background: linear-gradient(to top, var(--color-background), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-box {
      animation: pr-enter 0.45s ease-out both;
    }

    @keyframes pr-enter {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-rails::before,
    .projects-rails::after {
      animation: none;
    }
  }

  /* 竖屏：单列、左右交替缩进，变成一条竖着的蛇形 */
  @media (max-width: 900px) {
    .projects {
      --pr-gap: 1.25rem;
    }

    .projects-row[data-dir="rtl"] .projects-boxes {
      direction: ltr;
    }

    .projects-boxes {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 0.75rem;
    }

    .project-box {
      inline-size: 88%;
    }

    .projects-row[data-dir="rtl"] .project-box {
      margin-inline-start: auto;
    }

    .project-pop {
      inline-size: min(24rem, 92vw);
    }
  }
</style>

<script>
  function setupProjects() {
    const section = document.querySelector<HTMLElement>("[data-projects]");
    const sentinel = document.querySelector<HTMLElement>(
      "[data-projects-sentinel]"
    );
    if (!section) return;

    const rows = [...section.querySelectorAll<HTMLElement>(".projects-row")];
    let loaded = rows.filter(row => row.dataset.hidden !== "true").length;
    const BATCH = 4;

    const reveal = () => {
      let revealed = 0;
      for (const row of rows) {
        if (revealed >= BATCH) break;
        if (row.dataset.hidden === "true") {
          row.dataset.hidden = "false";
          revealed += 1;
          loaded += 1;
        }
      }
    };

    const nearBottom = () => {
      const doc = document.documentElement;
      return (
        window.scrollY > 20 &&
        window.scrollY + doc.clientHeight >= doc.scrollHeight - 260
      );
    };

    // 首屏保持 initialRows 行；开始往下滚、且接近底部前加载下一批
    const onScroll = () => {
      if (loaded < rows.length && nearBottom()) reveal();
    };
    window.addEventListener("scroll", onScroll, { passive: true });

    // 滚动时轴线"升温"
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let timer = 0;
    window.addEventListener(
      "scroll",
      () => {
        if (reduce.matches) return;
        section.dataset.heat = "true";
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          section.dataset.heat = "false";
        }, 200);
      },
      { passive: true }
    );
  }

  document.addEventListener("astro:page-load", setupProjects);
</script>
