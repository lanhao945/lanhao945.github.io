---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { getTagTransitionName } from "@/utils/getTagTransitionCss";

type TagCloudItem = {
  tag: string;
  tagName: string;
  count: number;
  latest: number;
};

type Props = {
  tags: TagCloudItem[];
};

const { tags } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const MAX_SIZE = 2.5;
const MIN_SIZE = 0.75;

/*
 * 排序：数量优先；数量相同看最近一次关联分享的更新时间；
 * 数量与时间都相同则按标签 slug 稳定排序（顺序本身不影响语义）。
 */
const items = [...tags]
  .sort(
    (a, b) =>
      b.count - a.count || b.latest - a.latest || a.tag.localeCompare(b.tag)
  )
  .map((item, rank, list) => {
    const ratio = list.length <= 1 ? 0 : rank / (list.length - 1);
    const size = MAX_SIZE - (MAX_SIZE - MIN_SIZE) * ratio;
    const tier = Math.min(3, Math.floor(ratio * 4));
    return { ...item, rank, size, tier };
  });
---

<script is:inline>
  document.documentElement.dataset.js = "true";
</script>

<div class="tag-cloud-shell">
  <div class="tag-cloud" data-tag-cloud data-ready="pending">
    <ul class="tag-cloud-stage" data-tag-cloud-stage>
      {
        items.map(({ tag, tagName, count, size, tier, rank }) => (
          <li
            class="tag-cloud-item"
            data-tag-item
            data-rank={rank}
            data-tier={tier}
            style={`--tag-size: ${size.toFixed(3)}rem`}
          >
            <a
              class="tag-cloud-link"
              data-tag-link
              href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
              title={`${tagName} (${count})`}
            >
              <span
                class="tag-cloud-name"
                style={{
                  viewTransitionName: getTagTransitionName(tag),
                }}
              >
                {tagName}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="tag-cloud-more" data-tag-more hidden>
    <ul class="tag-cloud-more-list" data-tag-more-list></ul>
  </div>
</div>

<style>
  .tag-cloud-shell {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    min-block-size: 0;
    flex-direction: column;
  }

  :global(html[data-js="true"])
    .tag-cloud[data-ready="pending"]
    .tag-cloud-stage {
    visibility: hidden;
    opacity: 0;
  }

  .tag-cloud {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    min-block-size: 0;
    inline-size: 100%;
  }

  @media (orientation: landscape) {
    .tag-cloud {
      flex: 0 0 auto;
      block-size: clamp(14rem, 58vh, 44rem);
      margin-block: clamp(0.75rem, 2.5vh, 2rem);
      overflow: hidden;
    }

    /* 全部标签都能放进词云时，让词云在剩余区域中垂直居中。 */
    .tag-cloud-shell[data-complete="true"] {
      justify-content: center;
    }
  }

  /* 没有 JS / 窄屏时的流式回退：所有标签按顺序换行展示 */
  .tag-cloud-stage {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1.2vw, 0.9rem) clamp(0.8rem, 1.8vw, 1.35rem);
    inline-size: 100%;
    margin: 0;
    padding: 1rem;
    list-style: none;
  }

  /* 螺旋排布完成后：云朵铺满可用区域，标签绝对定位 */
  .tag-cloud[data-ready="true"] {
    display: block;
    overflow: hidden;
  }

  .tag-cloud[data-ready="true"] .tag-cloud-stage {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
  }

  .tag-cloud[data-ready="true"] .tag-cloud-item {
    position: absolute;
    margin: 0;
    transform: translate(-50%, -50%);
  }

  .tag-cloud[data-ready="true"] .tag-cloud-name {
    max-inline-size: min(70vw, 42rem);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tag-cloud-name {
    display: inline-block;
  }

  .tag-cloud-link {
    display: inline-flex;
    align-items: center;
    gap: 0.08em;
    font-size: calc(var(--tag-size, 1.5rem) * var(--cloud-scale, 1));
    font-weight: 600;
    line-height: 1.05;
    white-space: nowrap;
    color: var(--color-foreground);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  /* 排名越靠前越接近主题色，越靠后越淡 */
  .tag-cloud-item[data-tier="0"] .tag-cloud-link {
    color: var(--color-accent);
  }

  .tag-cloud-item[data-tier="1"] .tag-cloud-link {
    color: color-mix(in srgb, var(--color-accent) 68%, var(--color-foreground));
  }

  .tag-cloud-item[data-tier="2"] .tag-cloud-link {
    color: var(--color-foreground);
  }

  .tag-cloud-item[data-tier="3"] .tag-cloud-link {
    color: var(--color-muted-foreground);
  }

  /* 悬停 / 聚焦：只放大当前标签 */
  .tag-cloud .tag-cloud-item:hover .tag-cloud-link,
  .tag-cloud .tag-cloud-item:focus-within .tag-cloud-link {
    transform: scale(1.14);
  }

  @media (max-width: 640px), (hover: none) {
    .tag-cloud-link {
      font-size: min(var(--tag-size, 1.5rem), 1.5rem);
    }
  }

  .tag-cloud-more {
    margin-block-start: 1.25rem;
    padding-block-start: 1rem;
    border-block-start: 1px dashed var(--color-border);
  }

  .tag-cloud-more[hidden] {
    display: none;
  }

  .tag-cloud-more-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-cloud-more-list .tag-cloud-item .tag-cloud-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted-foreground);
    transition: color 0.2s ease;
  }

  .tag-cloud-more-list .tag-cloud-item .tag-cloud-link:hover,
  .tag-cloud-more-list .tag-cloud-item .tag-cloud-link:focus-visible {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-cloud-link {
      transition: none;
    }
  }
</style>

<script>
  const CLOUD_SELECTOR = "[data-tag-cloud]";
  /* 超过这个数量就不再进入词云，改在下方流式区域展示。 */
  const MAX_CLOUD_TAGS = 80;
  /* 字号可读性下限；低于它时减少词云标签数量，而不是继续缩小。 */
  const MIN_CLOUD_SCALE = 0.72;

  type CloudBox = {
    x: number;
    y: number;
    w: number;
    h: number;
    padding?: number;
  };

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  /* 矩形四角都要落进椭圆内，保证所有标签都完整可见 */
  const containsInEllipse = (
    box: CloudBox,
    cx: number,
    cy: number,
    rx: number,
    ry: number
  ) => {
    const corners = [
      [box.x - box.w / 2, box.y - box.h / 2],
      [box.x + box.w / 2, box.y - box.h / 2],
      [box.x - box.w / 2, box.y + box.h / 2],
      [box.x + box.w / 2, box.y + box.h / 2],
    ];

    return corners.every(([x, y]) => {
      const dx = (x - cx) / rx;
      const dy = (y - cy) / ry;
      return dx * dx + dy * dy <= 1;
    });
  };

  const overlaps = (a: CloudBox, b: CloudBox) => {
    const gap = ((a.padding ?? 0) + (b.padding ?? 0)) / 2;
    return (
      Math.abs(a.x - b.x) < (a.w + b.w) / 2 + gap &&
      Math.abs(a.y - b.y) < (a.h + b.h) / 2 + gap
    );
  };

  /*
   * 参考 d3-cloud 等词云项目的 Archimedean spiral 排布：
   * 按权重从大到小依次放置，每个词沿螺旋从中心向外寻找第一个空位。
   * 先放的大词优先占据中心，后放的小词填补空隙并自然落到外围；
   * 不采用固定同心圆，避免出现大片空洞或局部过密。
   */
  const packCloud = (
    sizes: { w: number; h: number }[],
    width: number,
    height: number
  ) => {
    /*
     * 上下使用对称留白：全部标签放得下时，词云外接盒保持垂直居中，
     * 同时与上方分割线和下方 footer 保持距离。
     */
    const verticalGap = clamp(height * 0.08, 20, 48);
    const usableHeight = height - verticalGap * 2;

    if (usableHeight <= 0) return null;

    const cx = width / 2;
    const cy = height / 2;
    const rx = width / 2 - 6;
    const ry = usableHeight / 2 - 6;

    if (rx <= 0 || ry <= 0) return null;

    const yRatio = ry / rx;
    const count = sizes.length;
    const placed: CloudBox[] = [];
    const positions: { x: number; y: number }[] = [];

    /* 每转一圈向外扩张的半径，随容器尺寸缩放 */
    const radialStepPerTurn = clamp(Math.min(rx, ry) * 0.05, 10, 36);
    const spiralA = radialStepPerTurn / (Math.PI * 2);
    const angleStep = 0.05;
    const goldenAngle = 2.399963229728653;

    for (let i = 0; i < count; i += 1) {
      const { w, h } = sizes[i];
      const padding = clamp(Math.min(w, h) * 0.18, 6, 18);
      let found: CloudBox | null = null;

      if (i === 0) {
        const center: CloudBox = { x: cx, y: cy, w, h, padding };
        if (!containsInEllipse(center, cx, cy, rx, ry)) return null;
        found = center;
      } else {
        /*
         * 排名靠后的词给一个很小的起始半径，避免它们挤进最中心；
         * 但允许继续向内填补空隙，保证整体排布紧凑。
         */
        const rankRatio = count <= 1 ? 0 : i / (count - 1);
        const startR = Math.max(2, rankRatio * 0.04 * rx);
        const thetaStart = startR / spiralA;
        const thetaEnd = rx / spiralA;
        const angleOffset = i * goldenAngle;

        for (let theta = thetaStart; theta <= thetaEnd; theta += angleStep) {
          const r = spiralA * theta;
          const angle = theta + angleOffset;
          const candidate: CloudBox = {
            x: cx + Math.cos(angle) * r,
            y: cy + Math.sin(angle) * r * yRatio,
            w,
            h,
            padding,
          };

          if (!containsInEllipse(candidate, cx, cy, rx, ry)) continue;
          if (placed.some(item => overlaps(item, candidate))) continue;

          found = candidate;
          break;
        }
      }

      if (!found) return null;
      placed.push(found);
      positions.push({ x: found.x, y: found.y });
    }

    /*
     * 整体重心校准：螺旋的第一个可放角度可能让词团略偏一侧，
     * 这里把词团的外接盒平移到容器中心，让云朵更均匀地铺满区域。
     * 平移不改变相对关系，也不会引入新的碰撞。
     */
    const minX = Math.min(...positions.map((p, i) => p.x - sizes[i].w / 2));
    const maxX = Math.max(...positions.map((p, i) => p.x + sizes[i].w / 2));
    const minY = Math.min(...positions.map((p, i) => p.y - sizes[i].h / 2));
    const maxY = Math.max(...positions.map((p, i) => p.y + sizes[i].h / 2));
    const dx = cx - (minX + maxX) / 2;
    const dy = cy - (minY + maxY) / 2;

    for (let factor = 1; factor >= 0.05; factor *= 0.5) {
      const shifted = positions.map(p => ({
        x: p.x + dx * factor,
        y: p.y + dy * factor,
      }));
      const allInside = shifted.every((p, i) =>
        containsInEllipse(
          { x: p.x, y: p.y, w: sizes[i].w, h: sizes[i].h },
          cx,
          cy,
          rx,
          ry
        )
      );

      if (allInside) return shifted;
    }

    return positions;
  };

  function setupCloud(container: HTMLElement) {
    if (container.dataset.cloudReady === "true") return;

    const stage = container.querySelector<HTMLElement>(
      "[data-tag-cloud-stage]"
    );
    const shell = container.parentElement;
    const more = shell?.querySelector<HTMLElement>("[data-tag-more]");
    const moreList = shell?.querySelector<HTMLElement>("[data-tag-more-list]");
    const entries = [
      ...container.querySelectorAll<HTMLElement>("[data-tag-item]"),
    ]
      .map(item => ({
        item,
        link: item.querySelector<HTMLElement>("[data-tag-link]"),
      }))
      .filter(
        (entry): entry is { item: HTMLElement; link: HTMLElement } =>
          entry.link !== null
      );

    if (!stage || !shell || !more || !moreList || entries.length === 0) return;

    container.dataset.cloudReady = "true";

    const orientation = window.matchMedia("(orientation: landscape)");
    let lastKey = "";

    const moveAllToStage = () => {
      entries.forEach(({ item }) => stage.appendChild(item));
      more.hidden = true;
    };

    const resetLayoutState = () => {
      container.dataset.ready = "false";
      container.style.removeProperty("--cloud-scale");
      entries.forEach(({ item }) => {
        item.style.left = "";
        item.style.top = "";
      });
    };

    const showOverflow = (count: number) => {
      for (let i = count; i < entries.length; i += 1) {
        const item = entries[i].item;
        item.style.left = "";
        item.style.top = "";
        moreList.appendChild(item);
      }

      shell.dataset.complete = count >= entries.length ? "true" : "false";
      more.hidden = count >= entries.length;
    };

    const measure = () =>
      entries.map(({ link }) => ({
        w: link.offsetWidth,
        h: link.offsetHeight,
      }));

    const attempt = (
      count: number,
      scale: number,
      width: number,
      height: number
    ) => {
      container.style.setProperty("--cloud-scale", String(scale));
      const sizes = measure();
      const positions = packCloud(sizes.slice(0, count), width, height);

      return positions ? { count, scale, positions } : null;
    };

    const layout = () => {
      const width = Math.round(container.clientWidth);
      const height = Math.round(container.clientHeight);
      if (width <= 0 || height <= 0) return;

      const mode = orientation.matches ? "landscape" : "portrait";
      const key = `${mode}-${width}x${height}`;
      if (key === lastKey) return;
      lastKey = key;

      moveAllToStage();
      resetLayoutState();

      /* 竖屏不做词云，直接流式展示全部标签。 */
      if (!orientation.matches) {
        shell.dataset.complete = "true";
        return;
      }

      shell.dataset.complete = "false";

      const maxCount = Math.min(entries.length, MAX_CLOUD_TAGS);

      /*
       * 先确认最少一个标签在可读字号下能放下；
       * 否则只能退回流式布局，避免横屏出现空白。
       */
      if (!attempt(1, MIN_CLOUD_SCALE, width, height)) return;

      /*
       * 字号固定到可读下限后，用二分查找找出当前屏幕能容纳的最大数量。
       * packCloud 按同一顺序放置，减少尾部标签不会破坏前缀布局，
       * 因此“数量越少越容易放下”在当前实现中保持单调。
       */
      let low = 1;
      let high = maxCount;

      while (low < high) {
        const mid = Math.ceil((low + high) / 2);
        if (attempt(mid, MIN_CLOUD_SCALE, width, height)) {
          low = mid;
        } else {
          high = mid - 1;
        }
      }

      const count = low;
      const scaleSteps = [MIN_CLOUD_SCALE, 0.8, 0.88, 0.96];
      let best: {
        count: number;
        scale: number;
        positions: { x: number; y: number }[];
      } | null = null;

      for (const scale of scaleSteps) {
        const result = attempt(count, scale, width, height);
        if (!result) break;
        best = result;
      }

      if (!best) return;

      container.style.setProperty("--cloud-scale", String(best.scale));

      best.positions.forEach((position, index) => {
        entries[index].item.style.left = `${position.x.toFixed(2)}px`;
        entries[index].item.style.top = `${position.y.toFixed(2)}px`;
      });

      container.dataset.ready = "true";
      showOverflow(best.count);
    };

    let frame = 0;
    const scheduleLayout = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(layout);
    };

    const observer = new ResizeObserver(scheduleLayout);
    observer.observe(container);

    const handleOrientationChange = () => scheduleLayout();
    orientation.addEventListener?.("change", handleOrientationChange);

    document.addEventListener(
      "astro:before-swap",
      () => {
        observer.disconnect();
        orientation.removeEventListener?.("change", handleOrientationChange);
      },
      { once: true }
    );

    layout();
  }
  function setupAllTagClouds() {
    document.querySelectorAll<HTMLElement>(CLOUD_SELECTOR).forEach(setupCloud);
  }

  const initTagClouds = () => setupAllTagClouds();

  window.setTimeout(() => {
    document
      .querySelectorAll<HTMLElement>('[data-tag-cloud][data-ready="pending"]')
      .forEach(container => {
        container.dataset.ready = "false";
      });
  }, 1200);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTagClouds, {
      once: true,
    });
  } else {
    initTagClouds();
  }

  document.addEventListener("astro:page-load", initTagClouds);
</script>
