---
import type { TimelineGroup } from "@/utils/getSortedTimeline";
import TimelineItem from "./TimelineItem.astro";
import { useTranslations } from "@/i18n";

type Props = {
  groups: TimelineGroup[];
};

const { groups } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const total = groups.reduce((count, group) => count + group.items.length, 0);
const scrollable = groups.length > 1;
---

<section class="timeline" data-timeline aria-label={t.timeline.title}>
  {
    total === 0 ? (
      <p class="timeline-empty">{t.timeline.empty}</p>
    ) : (
      <div
        class="timeline-viewport"
        data-timeline-viewport
        role="region"
        aria-label={t.timeline.title}
        tabindex={scrollable ? 0 : -1}
      >
        <ol class="timeline-track">
          {groups.map(({ year, items }) => (
            <li class="timeline-year" id={`year-${year}`}>
              <h2 class="timeline-year-label">
                <span class="timeline-year-dot" aria-hidden="true" />
                <time datetime={String(year)}>{year}</time>
              </h2>
              <ol class="timeline-events">
                {items.map(entry => (
                  <TimelineItem entry={entry} />
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </div>
    )
  }

  <div class="timeline-footer">
    <p class="timeline-hint" data-timeline-hint data-hidden="false">
      <span aria-hidden="true">→</span>
      {t.timeline.scrollHint}
    </p>
    <div class="timeline-progress" aria-hidden="true">
      <span data-timeline-progress></span>
    </div>
  </div>
</section>

<style>
  /* 与 .app-layout（max-w-3xl + px-4）的内容左边缘对齐 */
  .timeline {
    --tl-gap: 2rem;
    --tl-column: min(20rem, 72vw);
    --tl-inset: max(1rem, calc((100% - 46rem) / 2));
    margin-top: 2.5rem;
  }

  .timeline-empty {
    margin: 0;
    padding-inline: var(--tl-inset);
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
  }

  .timeline-viewport {
    margin-top: 1.75rem;
    padding-inline: var(--tl-inset);
  }

  .timeline-viewport:focus-visible {
    outline: 2px dashed var(--color-accent);
    outline-offset: 2px;
  }

  .timeline-track {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline-year-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--color-muted-foreground);
  }

  .timeline-year-dot {
    display: none;
  }

  .timeline-events {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 底部提示与进度条：只在横屏且内容真的可以滚动时由脚本打开 */
  .timeline-footer {
    display: none;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
    padding-inline: var(--tl-inset);
  }

  .timeline[data-axis="x"][data-scrollable="true"] .timeline-footer {
    display: flex;
  }

  .timeline-hint {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: 0.8125rem;
    white-space: nowrap;
    color: var(--color-muted-foreground);
    transition: opacity 0.3s ease;
  }

  .timeline-hint[data-hidden="true"] {
    opacity: 0;
  }

  .timeline-progress {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .timeline-progress > span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .timeline-hint span {
      animation: timeline-nudge 2.4s ease-in-out infinite;
    }
  }

  @keyframes timeline-nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(0.25rem);
    }
  }

  /* ---------- 横屏：从左往右 ---------- */
  @media (min-width: 900px) and (orientation: landscape) {
    /* 首页在宽屏横屏下占满整屏：时间轴吃掉剩余高度，页面自身不滚动 */
    .timeline {
      /* 横屏时不再和上面的文字左对齐，向两侧多占一些 */
      --tl-inset: max(1.5rem, calc((100% - 96rem) / 2));
      display: flex;
      flex: 1 1 auto;
      min-block-size: 0;
      flex-direction: column;
      margin-top: 0.75rem;
    }

    .timeline-viewport {
      display: flex;
      flex: 1 1 auto;
      min-block-size: 0;
      margin-top: 0.5rem;
      /* 默认靠上/靠左（溢出时一定滚得到）；放得下时由下面两条规则切成居中 */
      align-items: flex-start;
      justify-content: flex-start;
      overflow-x: auto;
      /* 窗口特别矮时（内容高于可视区）仍能看到整列内容，滚轮会先纵向走完再横向移动 */
      overflow-y: auto;
      overscroll-behavior: contain;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--tl-inset);
      scrollbar-width: thin;
      padding-block-end: 0.5rem;
    }

    .timeline-track {
      flex: none;
    }

    /* 放得下：上下居中；左右也居中 */
    .timeline[data-overflow-y="false"] .timeline-viewport {
      align-items: center;
    }

    .timeline[data-overflow-x="false"] .timeline-viewport {
      justify-content: center;
    }

    /* 横屏下压缩一点，尽量让整列内容在一屏内 */
    .timeline-events {
      gap: 1rem;
    }

    .timeline-footer {
      flex: none;
    }

    .timeline-track {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--tl-gap);
    }

    .timeline-year {
      position: relative;
      flex: 0 0 auto;
      inline-size: var(--tl-column);
      scroll-snap-align: start;
    }

    /* 轴线固定在中间一行，年份文字在上/下交错 */
    .timeline-year-label {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: 1.25rem 1.25rem 1.25rem;
      align-items: center;
      column-gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .timeline-year-dot {
      grid-column: 1;
      grid-row: 2;
    }

    .timeline-year-label time {
      grid-column: 2;
      line-height: 1;
    }

    .timeline-year:nth-child(odd) .timeline-year-label time {
      grid-row: 1;
    }

    .timeline-year:nth-child(even) .timeline-year-label time {
      grid-row: 3;
    }

    .timeline-year-dot {
      display: block;
      position: relative;
      flex: none;
      inline-size: 0.5rem;
      block-size: 0.5rem;
      border-radius: 9999px;
      background: var(--color-accent);
    }

    /* 横向轴线：从本年的点连到下一年 */
    .timeline-year-dot::after {
      content: "";
      position: absolute;
      inset-inline-start: 100%;
      top: 50%;
      width: calc(var(--tl-column) + var(--tl-gap) - 0.5rem);
      height: 1px;
      background: var(--color-border);
    }

    .timeline-year:last-child .timeline-year-dot {
      box-shadow: 0 0 0 4px
        color-mix(in srgb, var(--color-accent) 18%, transparent);
    }

    .timeline-year:last-child .timeline-year-dot::after {
      display: none;
    }
  }
</style>

<script>
  const HORIZONTAL_QUERY = "(min-width: 900px) and (orientation: landscape)";

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  function setupTimeline() {
    const timeline = document.querySelector<HTMLElement>("[data-timeline]");
    const viewport = timeline?.querySelector<HTMLElement>(
      "[data-timeline-viewport]"
    );
    if (!timeline || !viewport) return;

    const track = timeline.querySelector<HTMLElement>(".timeline-track");
    const hint = timeline.querySelector<HTMLElement>("[data-timeline-hint]");
    const progress = timeline.querySelector<HTMLElement>(
      "[data-timeline-progress]"
    );
    const horizontal = window.matchMedia(HORIZONTAL_QUERY);

    const update = () => {
      const max = viewport.scrollWidth - viewport.clientWidth;
      const maxY = viewport.scrollHeight - viewport.clientHeight;
      const scrollable = horizontal.matches && max > 16;

      timeline.dataset.axis = horizontal.matches ? "x" : "y";
      timeline.dataset.scrollable = scrollable ? "true" : "false";
      timeline.dataset.overflowX = max > 1 ? "true" : "false";
      timeline.dataset.overflowY = maxY > 1 ? "true" : "false";

      if (hint) {
        hint.dataset.hidden =
          !scrollable || viewport.scrollLeft > 16 ? "true" : "false";
      }

      if (progress) {
        const ratio = max > 0 ? viewport.scrollLeft / max : 0;
        progress.style.transform = `scaleX(${clamp(ratio, 0, 1)})`;
      }
    };

    // 居中/靠边的切换会改变滚动条与可视高度，用 rAF 合并重算，避免状态过期
    let queued = false;
    const scheduleUpdate = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    viewport.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    horizontal.addEventListener("change", scheduleUpdate);

    if (typeof ResizeObserver !== "undefined") {
      const observer = new ResizeObserver(scheduleUpdate);
      observer.observe(viewport);
      if (track) observer.observe(track);
    }

    /*
     * 宽屏横屏时把纵向滚轮转成时间轴的横向滚动：
     * - 触控板横向滑动、Ctrl+滚轮（缩放）依旧交回浏览器
     * - 内容高于可视区时（窗口很矮）先纵向走完，再横向移动
     */
    if (viewport.dataset.wheelBound !== "true") {
      viewport.dataset.wheelBound = "true";
      const surface =
        document.querySelector<HTMLElement>('[data-layout="index"]') ??
        viewport;

      surface.addEventListener(
        "wheel",
        event => {
          if (!horizontal.matches || event.ctrlKey) return;
          if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;

          const maxX = viewport.scrollWidth - viewport.clientWidth;
          if (maxX <= 1) return;

          const step =
            event.deltaMode === 1
              ? event.deltaY * 16
              : event.deltaMode === 2
                ? event.deltaY * viewport.clientHeight
                : event.deltaY;

          const maxY = viewport.scrollHeight - viewport.clientHeight;
          if (maxY > 1 && !event.shiftKey) {
            const nextY = clamp(viewport.scrollTop + step, 0, maxY);
            if (nextY !== viewport.scrollTop) {
              viewport.scrollTop = nextY;
              event.preventDefault();
              return;
            }
          }

          event.preventDefault();
          viewport.scrollLeft = clamp(viewport.scrollLeft + step, 0, maxX);
        },
        { passive: false }
      );
    }

    scheduleUpdate();
  }

  document.addEventListener("astro:page-load", setupTimeline);
</script>
