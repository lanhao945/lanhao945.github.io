---
import type { TimelineColumn } from "@/utils/getSortedTimeline";
import TimelineItem from "./TimelineItem.astro";
import {
  buildActivityField,
  buildEvidenceSlots,
  mergeActivitySources,
} from "@/utils/githubActivity.mjs";
import { useTranslations } from "@/i18n";

type Props = {
  columns: TimelineColumn[];
};

const { columns } = Astro.props;
const t = useTranslations(Astro.currentLocale);

const total = columns.reduce(
  (count, column) =>
    count + column.stacks.reduce((n, stack) => n + stack.items.length, 0),
  0
);
const scrollable = columns.length > 1;
const activitySourceModules = import.meta.glob(
  "/src/data/activity-sources/**/*.json",
  { eager: true, import: "default" }
);
const mergedActivityDays = mergeActivitySources(activitySourceModules);

/*
 * 列模型：占位只由卡片年决定 —— 区间不额外占列，卡片间距因此处处一致。
 * 连续无卡片的年份记成区间：区间内有贡献时，活动场会在那条标准间隙里画一条
 * 水平均值带；页面上不显示任何跨度文字（信息走读屏文本）。竖屏不展示活动场，
 * 因此不受影响。
 */
const { slots, gaps } = buildEvidenceSlots(
  columns.map(column => column.year),
  mergedActivityDays
);
const columnByYear = new Map(columns.map(column => [column.year, column]));
const slotColumns = slots.map((slot, index) => ({
  slot,
  index,
  column: columnByYear.get(slot.year) ?? null,
}));
const stretchNotes = gaps
  .filter(gap => gap.meanPerDay > 0)
  .map(gap => ({
    label: `${gap.from === gap.to ? gap.from : `${gap.from}–${gap.to}`} · 日均 ${gap.meanPerDay.toFixed(1)} 次 · 累计 ${gap.total}`,
  }));
const activityField = buildActivityField(mergedActivityDays, { slots, gaps });
---

<section class="timeline" data-timeline aria-label={t.timeline.title}>
  {
    total === 0 ? (
      <p class="timeline-empty">{t.timeline.empty}</p>
    ) : (
      <div class="timeline-frame">
        <div
          class="timeline-viewport"
          data-timeline-viewport
          role="region"
          aria-label={t.timeline.title}
          tabindex={scrollable ? 0 : -1}
        >
          <ol class="timeline-track" style={`--tl-columns: ${slots.length}`}>
            {activityField.hasData && (
              <li class="timeline-activity" aria-hidden="true">
                <svg
                  class="timeline-activity-svg"
                  viewBox={activityField.viewBox}
                  data-base-view-box={activityField.viewBox}
                  preserveAspectRatio="none"
                >
                  <defs>
                    <linearGradient
                      id="tl-activity-upper-gradient"
                      x1="0"
                      y1="0"
                      x2="0"
                      y2="1"
                    >
                      <stop class="timeline-activity-stop-faint" offset="0%" />
                      <stop
                        class="timeline-activity-stop-upper"
                        offset="100%"
                      />
                    </linearGradient>
                    <linearGradient
                      id="tl-activity-lower-gradient"
                      x1="0"
                      y1="0"
                      x2="0"
                      y2="1"
                    >
                      <stop class="timeline-activity-stop-lower" offset="0%" />
                      <stop
                        class="timeline-activity-stop-faint"
                        offset="100%"
                      />
                    </linearGradient>
                  </defs>
                  <path
                    class="timeline-activity-upper"
                    fill="url(#tl-activity-upper-gradient)"
                    d={activityField.upperPath}
                  />
                  <path
                    class="timeline-activity-lower"
                    fill="url(#tl-activity-lower-gradient)"
                    d={activityField.lowerPath}
                  />
                </svg>
              </li>
            )}

            {/* 纯装饰：沿轴线流动的光带（横屏生效；脚本接管后与自动滚动同速率） */}
            <li class="timeline-flow" aria-hidden="true" />
            {slotColumns.map(({ slot, index, column }) =>
              column ? (
                <li
                  class="timeline-year"
                  id={`year-${slot.year}`}
                  data-station="true"
                  data-year={slot.year}
                  data-items={column.stacks.reduce(
                    (count, stack) => count + stack.items.length,
                    0
                  )}
                  style={`--tl-col: ${index + 1}`}
                >
                  <h2 class="timeline-year-label">
                    <span class="timeline-year-dot" aria-hidden="true" />
                    <time datetime={String(slot.year)}>{slot.year}</time>
                  </h2>
                  {column.stacks.map(stack =>
                    stack.items.length > 0 ? (
                      <ol class="timeline-events" data-side={stack.side}>
                        {stack.items.map(entry => (
                          <TimelineItem entry={entry} />
                        ))}
                      </ol>
                    ) : null
                  )}
                </li>
              ) : null
            )}
            {/* 区间信息：不显示可见文字，只给读屏 */}
            {stretchNotes.map(note => (
              <li class="sr-only">{note.label}</li>
            ))}
          </ol>
        </div>
      </div>
    )
  }
</section>

<style>
  .timeline {
    --tl-gap: 2rem;
    --tl-column: min(20rem, 72vw);
    --tl-inset: max(1rem, calc((100% - 46rem) / 2));
    /* 光带强度与颜色：浅色克制、暗色为主场 */
    --tl-flow: 0.45;
    --tl-flow-hot: 0.85;
    --tl-flow-color: color-mix(in srgb, var(--color-accent) 85%, #000);
    margin-top: 2.5rem;
  }

  :global([data-theme="dark"]) .timeline {
    --tl-flow: 0.55;
    --tl-flow-hot: 1;
    /* 暗色下轴线本身就是橙色，光带需要更亮的"热芯"才看得出来 */
    --tl-flow-color: color-mix(in srgb, var(--color-accent) 60%, #fff);
  }

  /* 活动场与光带只在横屏出现；竖屏不展示 GitHub 活动。 */
  .timeline-activity,
  .timeline-flow {
    display: none;
  }

  /* 进站序列：年份与卡片按列依次浮现（关闭动效偏好时自动禁用） */
  @media (prefers-reduced-motion: no-preference) {
    .timeline-year-label {
      animation: tl-enter 0.5s ease-out both;
      animation-delay: calc(var(--tl-col, 1) * 70ms);
    }

    .timeline-events {
      animation: tl-enter 0.5s ease-out both;
      animation-delay: calc(var(--tl-col, 1) * 70ms + 120ms);
    }

    @keyframes tl-enter {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
    }
  }

  .timeline-empty {
    margin: 0;
    padding-inline: var(--tl-inset);
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
  }

  .timeline-viewport {
    margin-top: 1.75rem;
    padding-inline: var(--tl-inset);
  }

  .timeline-viewport:focus-visible {
    outline: 2px dashed var(--color-accent);
    outline-offset: 2px;
  }

  .timeline-track {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline-year-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--color-muted-foreground);
  }

  .timeline-year-dot {
    display: none;
  }

  .timeline-events {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 竖屏：同一年分成两段渲染，接缝处保持与段内一致的间距 */
  .timeline-events + .timeline-events {
    margin-top: 1.75rem;
  }

  /* ---------- 横屏：从左往右，卡片上下交错 ---------- */
  @media (min-width: 900px) and (orientation: landscape) {
    /* 首页在宽屏横屏下占满整屏：时间轴吃掉剩余高度，页面自身不滚动 */
    .timeline {
      /* 横屏时不再和上面的文字左对齐，向两侧多占一些 */
      /* 外侧纯留白（不画任何内容）：随窗口宽度自适应 */
      --tl-edge: clamp(3.5rem, 6vw, 7rem);
      /* 内侧渐变带宽度：与留白解耦，保持现在的观感 */
      --tl-fade: 3rem;
      /* 内容静止位置：刚好让开渐变带 */
      --tl-inset: max(var(--tl-fade), calc((100% - 96rem) / 2));
      display: flex;
      flex: 1 1 auto;
      min-block-size: 0;
      flex-direction: column;
      margin-top: 0.75rem;
    }

    /* 取景框：负责高度与两侧渐隐，滚动发生在里面的 viewport */
    .timeline-frame {
      position: relative;
      display: flex;
      flex: 1 1 auto;
      min-block-size: 0;
      margin-top: 0.5rem;
      /*
       * 外侧留白：这一条里不画任何内容（硬裁切在 --tl-edge 处），
       * 渐变带再从这条留白的内侧往内容方向铺开同样宽度。
       */
      margin-inline: var(--tl-edge);
    }

    .timeline-viewport {
      display: flex;
      flex: 1 1 auto;
      min-block-size: 0;
      /* 纵向靠上：真正的上下居中由轨道自己做（内容再高也不会被裁掉） */
      align-items: flex-start;
      justify-content: flex-start;
      overflow-x: auto;
      /* 窗口特别矮时（内容高于可视区）仍能看到整列内容，滚轮会先纵向走完再横向移动 */
      overflow-y: auto;
      overscroll-behavior: contain;
      scroll-padding-inline: var(--tl-inset);
      /* 隐藏原生滚动条：滚动反馈交给底部那条自绘进度线 */
      scrollbar-width: none;
    }

    .timeline-viewport::-webkit-scrollbar {
      display: none;
    }

    /* 两侧渐隐：内容滚出边界时淡出，而不是被硬切 */
    .timeline-frame::before,
    .timeline-frame::after {
      content: "";
      position: absolute;
      inset-block: 0;
      inline-size: var(--tl-fade);
      z-index: 1;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .timeline-frame::before {
      inset-inline-start: 0;
      background: linear-gradient(
        to right,
        var(--color-background),
        transparent
      );
    }

    .timeline-frame::after {
      inset-inline-end: 0;
      background: linear-gradient(
        to left,
        var(--color-background),
        transparent
      );
    }

    /* 已经在最左/最右时，对应那一侧不渐隐 */
    .timeline[data-at-start="false"] .timeline-frame::before,
    .timeline[data-at-end="false"] .timeline-frame::after {
      opacity: 1;
    }

    /* 放得下时整体水平居中，放不下就靠左排开、可滚动 */
    .timeline[data-overflow-x="false"] .timeline-viewport {
      justify-content: center;
    }

    /* 轨道 = 上卡片 | 轴线 | 下卡片 三行网格，轴线天然是直的 */
    /* 轴线上的流动光带：跟着轴线那一行居中 */
    .timeline-track {
      position: relative;
      isolation: isolate;
    }

    .timeline-activity {
      position: absolute;
      z-index: 0;
      inset: 0;
      display: block;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.45s ease-out;
      mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        #000 14%,
        #000 86%,
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        #000 14%,
        #000 86%,
        transparent 100%
      );
    }

    .timeline-activity[data-aligned="true"] {
      opacity: 1;
    }

    .timeline-activity-svg {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      opacity: 0.92;
    }

    :global([data-theme="dark"]) .timeline-activity-svg {
      opacity: 0.78;
    }

    @media (prefers-reduced-motion: reduce) {
      .timeline-activity {
        transition: none;
      }
    }

    .timeline-activity-stop-faint {
      stop-color: var(--color-accent);
      stop-opacity: 0;
    }

    .timeline-activity-stop-upper {
      stop-color: var(--color-accent);
      stop-opacity: 0.34;
    }

    .timeline-activity-stop-lower {
      stop-color: var(--color-accent);
      stop-opacity: 0.18;
    }

    :global([data-theme="dark"]) .timeline-activity-stop-upper {
      stop-opacity: 0.24;
    }

    :global([data-theme="dark"]) .timeline-activity-stop-lower {
      stop-opacity: 0.15;
    }

    .timeline-flow {
      display: block;
      z-index: 2;
      grid-row: 2;
      grid-column: 1 / -1;
      align-self: center;
      /* 3px：中间 1px 压在轴线上，上下各 1px 形成光晕 */
      block-size: 3px;
      overflow: hidden;
      pointer-events: none;
      opacity: var(--tl-flow);
      transition: opacity 0.6s ease;
    }

    .timeline-flow::before {
      content: "";
      display: block;
      block-size: 100%;
      /* 32%：光带宽度；脚本按同一比例把"固定速率"换算成行进距离 */
      inline-size: 32%;
      background: linear-gradient(
        90deg,
        transparent,
        var(--tl-flow-color),
        transparent
      );
      transform: translateX(-100%);
      /* 无 JS 时的兜底循环；脚本接管后由 data-flow 关掉、改按固定速率驱动 */
      animation: tl-flow 7s linear infinite;
    }

    /*
     * data-flow 出现即代表脚本接管光带：pending / running / settled 都不再循环，
     * --tl-flow-x 由脚本按"逐站巡航"给出（光带中心停在当前站点的节点上）。
     */
    .timeline[data-flow] .timeline-flow::before {
      animation: none;
      transform: translateX(var(--tl-flow-x, -100%));
    }

    /* 预告落定后：光带在落点列上轻微呼吸（提示可以继续滚，不产生位移） */
    .timeline[data-flow="settled"] .timeline-flow {
      animation: tl-breathe 2.6s ease-in-out infinite;
    }

    @keyframes tl-breathe {
      0%,
      100% {
        opacity: var(--tl-flow);
      }
      50% {
        opacity: calc(var(--tl-flow) * 0.78);
      }
    }

    /* 走过的年份：轴线点亮成暖色，越靠近当前列越亮；不随时间衰减 */
    .timeline-year[data-tour="passed"] .timeline-year-dot::after {
      background: color-mix(
        in srgb,
        var(--color-accent) 65%,
        var(--color-border)
      );
      opacity: var(--tl-trail, 1);
      transition: opacity 0.5s ease-out;
    }

    /* 悬停某张卡片时，把该年的节点与年份文字一起点亮
       （卡片本身在 TimelineItem 里，跨组件选择要 :global） */
    :global(.timeline-year:has(.timeline-event:hover) .timeline-year-dot) {
      background: var(--color-accent);
      box-shadow: 0 0 0 5px
        color-mix(in srgb, var(--color-accent) 22%, transparent);
    }

    .timeline-year:has(:global(.timeline-event):hover)
      .timeline-year-label
      time {
      color: var(--color-foreground);
    }

    /* 滚动时"升温"：快速点亮，松手后慢慢冷却（停止后不再复活） */
    .timeline[data-flow="running"][data-heat="true"] .timeline-flow {
      opacity: var(--tl-flow-hot);
      transition-duration: 0.12s;
    }

    @keyframes tl-flow {
      from {
        transform: translateX(-100%);
      }
      to {
        transform: translateX(320%);
      }
    }

    /* 当前年份（离视口中心最近的那一年）放大点亮 */
    .timeline-year[data-current="true"] .timeline-year-dot {
      inset-inline-start: 50%;
      inline-size: 0.6875rem;
      block-size: 0.6875rem;
      box-shadow: 0 0 0 5px
        color-mix(in srgb, var(--color-accent) 18%, transparent);
    }

    .timeline-year[data-current="true"] .timeline-year-label time {
      color: var(--color-foreground);
    }

    .timeline-year-dot {
      transition:
        inline-size 0.25s ease,
        block-size 0.25s ease,
        box-shadow 0.25s ease;
    }

    .timeline-year-label time {
      transition: color 0.25s ease;
    }

    /* 节点在滚动时轻微发光 */
    .timeline-year-dot::before {
      content: "";
      position: absolute;
      inset: -3px;
      border-radius: 9999px;
      background: radial-gradient(
        circle,
        color-mix(in srgb, var(--color-accent) 45%, transparent),
        transparent 70%
      );
      opacity: 0;
      transition: opacity 0.6s ease;
    }

    .timeline[data-heat="true"] .timeline-year-dot::before {
      opacity: 1;
      transition-duration: 0.12s;
    }

    .timeline-track {
      display: grid;
      grid-template-columns: repeat(var(--tl-columns), var(--tl-column));
      grid-template-rows: auto auto auto;
      align-items: end;
      column-gap: var(--tl-gap);
      row-gap: 0.25rem;
      flex: none;
      /* 至少和可视区一样高，多余空间自动上下均分；内容更高时自然撑开并可滚动 */
      block-size: max-content;
      min-block-size: 100%;
      align-content: center;
    }

    /* 年份这一层不生成盒子，让里面的三块直接落到轨道网格上 */
    .timeline-year {
      display: contents;
    }

    /* 内容层始终在活动场之上。 */
    .timeline-events,
    .timeline-year-label {
      position: relative;
      z-index: 1;
    }

    .timeline-events[data-side="top"] {
      grid-column: var(--tl-col);
      grid-row: 1;
      align-self: end;
      gap: 1rem;
    }

    .timeline-events[data-side="bottom"] {
      grid-column: var(--tl-col);
      grid-row: 3;
      align-self: start;
      gap: 1rem;
    }

    .timeline-events + .timeline-events {
      margin-top: 0;
    }

    /* 年份标签固定在轴线那一行，文字仍按奇偶在轴线上/下交错 */
    .timeline-year-label {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: 1.25rem 1.25rem 1.25rem;
      align-items: center;
      column-gap: 0.5rem;
      margin: 0;
      grid-column: var(--tl-col);
      grid-row: 2;
      align-self: center;
      scroll-snap-align: start;
    }

    /* 年份文字统一在轴线上方：卡片分居两侧时，标签位置固定才好对照 */
    .timeline-year-label time {
      grid-column: 2;
      grid-row: 1;
      line-height: 1;
    }

    .timeline-year-dot {
      display: block;
      grid-column: 1;
      grid-row: 2;
      position: relative;
      inline-size: 0.5rem;
      block-size: 0.5rem;
      border-radius: 9999px;
      background: var(--color-accent);
    }

    /* 横向轴线：从本年的点连到下一年 */
    .timeline-year-dot::after {
      content: "";
      position: absolute;
      inset-inline-start: 100%;
      top: 50%;
      width: calc(var(--tl-column) + var(--tl-gap) - 0.5rem);
      height: 1px;
      background: var(--color-border);
    }

    .timeline-year:last-child .timeline-year-dot {
      box-shadow: 0 0 0 4px
        color-mix(in srgb, var(--color-accent) 18%, transparent);
    }

    .timeline-year:last-child .timeline-year-dot::after {
      display: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .timeline-flow::before {
        animation: none;
        transform: translateX(120%);
      }

      .timeline[data-flow="settled"] .timeline-flow {
        animation: none;
      }
    }
  }
</style>

<script>
  import {
    bindActivityAlignmentRefresh,
    computeAlignedActivityViewBox,
    parseTranslateY,
  } from "@/utils/githubActivity.mjs";
  import {
    TEASER_DEFAULTS,
    planTeaser,
    teaserWalk,
  } from "@/utils/timelineTour.mjs";

  const HORIZONTAL_QUERY = "(min-width: 900px) and (orientation: landscape)";
  const horizontal = window.matchMedia(HORIZONTAL_QUERY);

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  // 首页巡航的停止句柄（true = 瞬时吸附到最近站，供滚轮接管使用）
  let activeFlowRun: ((immediate?: boolean) => void) | null = null;

  const getTimeline = () => {
    const timeline = document.querySelector<HTMLElement>("[data-timeline]");
    const viewport = timeline?.querySelector<HTMLElement>(
      "[data-timeline-viewport]"
    );
    return timeline && viewport ? { timeline, viewport } : null;
  };

  /*
   * 滚轮 → 时间轴横向滚动。
   * 监听挂在 document 上、只挂一次：视图切换后时间轴元素会换成新的，
   * 挂在元素上的监听会随之失效，这里每次事件重新查询当前节点。
   */
  function handleWheel(event: WheelEvent) {
    // Ctrl+滚轮（缩放）、竖屏/窄屏、触控板横向滑动：都交回浏览器
    if (event.ctrlKey || !horizontal.matches) return;
    if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;

    const parts = getTimeline();
    if (!parts) return;
    const { viewport } = parts;

    const maxX = viewport.scrollWidth - viewport.clientWidth;
    if (maxX <= 1) return;

    // 首页整屏接管；其它页面只有指针在时间轴里才接管
    const onHome = document.body.classList.contains("home");
    if (!onHome && !event.composedPath().includes(viewport)) return;

    // 用户开始用滚轮接管：立即停下巡航并瞬时吸附到最近一站，
    // 之后本次滚轮步进照常生效（不会与巡航的位移互相覆盖）
    activeFlowRun?.(true);

    const step =
      event.deltaMode === 1
        ? event.deltaY * 16
        : event.deltaMode === 2
          ? event.deltaY * viewport.clientHeight
          : event.deltaY;

    // 窗口特别矮、一列装不下时：先把这一列纵向看完，再继续往右
    const maxY = viewport.scrollHeight - viewport.clientHeight;
    if (maxY > 8 && !event.shiftKey) {
      const nextY = clamp(viewport.scrollTop + step, 0, maxY);
      if (nextY !== viewport.scrollTop) {
        viewport.scrollTop = nextY;
        event.preventDefault();
        return;
      }
    }

    event.preventDefault();
    viewport.scrollLeft = clamp(viewport.scrollLeft + step, 0, maxX);
  }

  function setupTimeline() {
    const parts = getTimeline();
    if (!parts) return;
    const { timeline, viewport } = parts;
    if (timeline.dataset.timelineReady === "true") return;

    // 视图切换后旧时间轴已离场：先收掉它的巡航
    activeFlowRun?.();

    const track = timeline.querySelector<HTMLElement>(".timeline-track");

    /*
     * 首页开场预告
     * ---------------------------------------------------------------
     * 一次连续滑行：前段恒速、末段减速，并在落点前小幅过冲 10px 再平滑
     * 回弹落定（回弹属于同一次运动，不存在"停住之后再动一下"）。落定后
     * 光带轻微呼吸提示可以继续滚；用户一接管就立即停止并吸附到最近列
     * （滚轮走瞬时吸附，避免与滚轮步进互相覆盖）。
     */
    const SETTLE_MS = 180; // ms：接管后吸附到最近列（<= 200ms）
    const FLOW_WIDTH_RATIO = 0.32; // 与 .timeline-flow::before 的 inline-size 一致

    const flow = timeline.querySelector<HTMLElement>(".timeline-flow");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const stationElements = () =>
      Array.from(
        timeline.querySelectorAll<HTMLElement>(".timeline-year[data-station]")
      );

    /** 站点节点（年份圆点）的屏幕坐标盒；隐藏或不可测量时返回 null。 */
    const stationNodeBox = (element: HTMLElement) => {
      const dot = element.querySelector<HTMLElement>(".timeline-year-dot");
      const label = element.querySelector<HTMLElement>(".timeline-year-label");
      const box =
        dot?.getBoundingClientRect() ??
        label?.getBoundingClientRect() ??
        element.getBoundingClientRect();
      return box.width > 0 || box.height > 0 ? box : null;
    };

    const maxScrollX = () =>
      Math.max(0, viewport.scrollWidth - viewport.clientWidth);

    /** 让该站点落在视口正中所需的 scrollLeft。 */
    const targetScrollFor = (element: HTMLElement) => {
      const box = stationNodeBox(element);
      if (!box) return null;
      const viewportBox = viewport.getBoundingClientRect();
      const delta =
        box.left + box.width / 2 - (viewportBox.left + viewportBox.width / 2);
      return clamp(viewport.scrollLeft + delta, 0, maxScrollX());
    };

    /** 站点节点在轨道（光带容器）坐标系里的位置。 */
    const trackXFor = (element: HTMLElement) => {
      const box = stationNodeBox(element);
      const trackBox = flow?.getBoundingClientRect();
      if (!box || !trackBox || trackBox.width <= 0) return null;
      return box.left + box.width / 2 - trackBox.left;
    };

    /** 一个"列距"（列宽 + 间隙）：用相邻两站的节点间距量出来。 */
    const columnPitch = () => {
      const elements = stationElements();
      if (elements.length < 2) return 0;
      const first = stationNodeBox(elements[0]);
      const second = stationNodeBox(elements[1]);
      if (!first || !second) return 0;
      return Math.abs(second.left - first.left);
    };

    let bandTrackX = 0; // 光带中心在轨道坐标系里的位置（px）

    /** 让光带中心落在轨道坐标 trackX 上。 */
    const paintBand = (trackX: number) => {
      if (!flow) return;
      const bandWidth = flow.getBoundingClientRect().width * FLOW_WIDTH_RATIO;
      if (bandWidth <= 0) return;
      bandTrackX = trackX;
      flow.style.setProperty(
        "--tl-flow-x",
        `${(trackX / bandWidth) * 100 - 50}%`
      );
    };

    let flowRaf = 0;
    let flowTimer = 0;
    let flowLastFrame = 0;
    let flowPhase: "pending" | "move" | "settled" = "settled";
    let flowElapsed = 0;
    let flowStopping = false; // 接管后的吸附：到位即结束
    let moveFromScroll = 0;
    let moveToScroll = 0;
    let moveFromBand = 0;
    let moveToBand = 0;
    let moveDuration = 0;
    let moveCruiseRatio: number = TEASER_DEFAULTS.cruiseRatio;
    let moveSettleRatio: number = TEASER_DEFAULTS.settleRatio;
    let moveDistance = 0;
    let moveOvershoot = 0;
    let moveSign = 1;
    let trailHead = -1; // 已点亮的轨迹到第几列

    const cancelFlowTicks = () => {
      if (flowRaf) {
        cancelAnimationFrame(flowRaf);
        flowRaf = 0;
      }
      if (flowTimer) {
        window.clearTimeout(flowTimer);
        flowTimer = 0;
      }
    };

    /**
     * 收尾：取消所有计时，光带停在原地保持可见，不再位移。
     * `finalState` 用 settled（自然落定，光带呼吸作为"可继续"提示）或
     * manual（用户接管，不再呼吸）。
     */
    const endRun = (finalState: "settled" | "manual" = "settled") => {
      cancelFlowTicks();
      flowPhase = "settled";
      flowStopping = false;
      timeline.dataset.flow = finalState;
      if (activeFlowRun === requestStop) activeFlowRun = null;
    };

    /** 点亮轨迹到指定列为止：越靠近该列越亮，且不回退、不随时间衰减。 */
    const lightTrailUpTo = (element: HTMLElement | null) => {
      const years = [
        ...timeline.querySelectorAll<HTMLElement>(".timeline-year"),
      ];
      const head = element ? years.indexOf(element) : -1;
      if (head === trailHead) return;
      trailHead = head;
      years.forEach((year, index) => {
        if (head < 0 || index > head) return;
        year.dataset.tour = "passed";
        year.style.setProperty(
          "--tl-trail",
          String(Math.max(0.45, 1 - (head - index) * 0.18))
        );
      });
    };

    /**
     * 开场预告：一次连续滑行（前段恒速 + 末段缓出）落在构图完整的列上，
     * 然后把控制权交还访客（可选的一次轻推作为"可继续"的提示）。
     */
    const startTeaser = () => {
      flowTimer = 0;
      if (!flow || !horizontal.matches || reduceMotion.matches) return;
      if (timeline.dataset.flow === "settled") return;

      const elements = stationElements();
      if (elements.length === 0) {
        endRun();
        return;
      }

      const plan = planTeaser({
        stations: elements.map(element => ({
          year: Number(element.dataset.year),
          targetScroll: targetScrollFor(element) ?? 0,
        })),
        columnPitch: columnPitch(),
        fromScroll: viewport.scrollLeft,
      });

      const landing = elements[plan.landingIndex];
      const landingBand = landing ? trackXFor(landing) : null;
      if (!landing || landingBand === null || plan.distance < 1) {
        endRun(); // 没有可走的距离（或几何不可用）：直接落定
        return;
      }

      flowStopping = false;
      flowElapsed = 0;
      flowLastFrame = 0;
      flowPhase = "move";
      moveFromScroll = viewport.scrollLeft;
      moveToScroll = plan.landingScroll;
      moveFromBand = bandTrackX;
      moveToBand = landingBand;
      moveDuration = plan.durationMs;
      moveCruiseRatio = plan.cruiseRatio;
      moveSettleRatio = plan.settleRatio;
      moveDistance = plan.distance;
      moveOvershoot = plan.overshootPx;
      moveSign = Math.sign(plan.landingScroll - viewport.scrollLeft) || 1;
      timeline.dataset.flow = "running";
      activeFlowRun = requestStop;
      flowRaf = requestAnimationFrame(stepFlow);
    };

    /** 用户接管：立即停止预告/轻推，并吸附到最近的一列（immediate = 瞬时）。 */
    const requestStop = (immediate = false) => {
      const state = timeline.dataset.flow;
      if (state !== "pending" && state !== "running") return; // 已经落定
      cancelFlowTicks();

      const elements = stationElements();
      if (elements.length === 0) {
        endRun();
        return;
      }

      let nearest = 0;
      let best = Number.POSITIVE_INFINITY;
      elements.forEach((element, index) => {
        const target = targetScrollFor(element);
        if (target === null) return;
        const distance = Math.abs(target - viewport.scrollLeft);
        if (distance < best) {
          best = distance;
          nearest = index;
        }
      });

      if (immediate) {
        const target = targetScrollFor(elements[nearest]);
        const band = trackXFor(elements[nearest]);
        if (target !== null && band !== null) {
          viewport.scrollLeft = target;
          paintBand(band);
        }
        endRun("manual");
        return;
      }

      const target = targetScrollFor(elements[nearest]);
      const band = trackXFor(elements[nearest]);
      timeline.dataset.flow = "running";
      flowStopping = true;
      flowElapsed = 0;
      flowLastFrame = 0;
      flowPhase = "move";
      moveFromScroll = viewport.scrollLeft;
      moveToScroll = target ?? viewport.scrollLeft;
      moveFromBand = bandTrackX;
      moveToBand = band ?? bandTrackX;
      moveDuration = SETTLE_MS;
      moveCruiseRatio = 1;
      moveSettleRatio = 0.05;
      moveDistance = Math.abs(moveToScroll - moveFromScroll);
      moveOvershoot = 0; // 接管吸附：不过冲
      moveSign = Math.sign(moveToScroll - moveFromScroll) || 1;
      flowRaf = requestAnimationFrame(stepFlow);
    };

    const stepFlow = (now: number) => {
      flowRaf = 0;
      if (
        !flow ||
        !horizontal.matches ||
        reduceMotion.matches ||
        !viewport.isConnected
      ) {
        endRun();
        return;
      }

      // 切后台/长卡顿会把帧间隔拉大：夹住上限避免瞬移
      const delta = flowLastFrame ? Math.min(now - flowLastFrame, 250) : 0;
      flowLastFrame = now;

      if (flowPhase === "move") {
        flowElapsed += delta;
        const progress =
          moveDuration > 0 ? Math.min(1, flowElapsed / moveDuration) : 1;
        const walked = flowStopping
          ? moveDistance * progress // 接管吸附：线性、不过冲
          : teaserWalk(progress, {
              distance: moveDistance,
              overshoot: moveOvershoot,
              cruiseRatio: moveCruiseRatio,
              settleRatio: moveSettleRatio,
            });

        viewport.scrollLeft = moveFromScroll + moveSign * walked;
        const bandRatio = moveDistance > 0 ? walked / moveDistance : 1;
        paintBand(moveFromBand + (moveToBand - moveFromBand) * bandRatio);

        if (progress >= 1) {
          // 自然落定 → settled（光带呼吸提示可继续）；接管吸附 → manual
          endRun(flowStopping ? "manual" : "settled");
          return;
        }
      } else {
        return; // settled：循环自然结束
      }

      flowRaf = requestAnimationFrame(stepFlow);
    };

    const queueFlowRun = () => {
      if (!flow || !horizontal.matches || reduceMotion.matches) return;
      if (timeline.dataset.flow === "settled") return;
      if (flowRaf || flowTimer) return;

      const first = stationElements()[0];
      const firstBand = first ? trackXFor(first) : null;
      if (firstBand !== null) paintBand(firstBand);

      // pending：光带先停在起点待命，CSS 的兜底循环不会先转起来
      flowPhase = "pending";
      timeline.dataset.flow = "pending";
      activeFlowRun = requestStop;
      flowTimer = window.setTimeout(startTeaser, TEASER_DEFAULTS.startDelayMs);
    };

    const update = () => {
      const max = viewport.scrollWidth - viewport.clientWidth;
      const maxY = viewport.scrollHeight - viewport.clientHeight;
      timeline.dataset.axis = horizontal.matches ? "x" : "y";
      timeline.dataset.overflowX = max > 1 ? "true" : "false";
      timeline.dataset.overflowY = maxY > 1 ? "true" : "false";
      timeline.dataset.atStart = viewport.scrollLeft <= 4 ? "true" : "false";
      timeline.dataset.atEnd =
        max <= 1 || viewport.scrollLeft >= max - 4 ? "true" : "false";

      // 当前年份：选出离视口中心最近的那一年（屏幕坐标比较，和滚动/变换无关）
      const viewportBox = viewport.getBoundingClientRect();
      const centerX = viewportBox.left + viewportBox.width / 2;
      let current: Element | null = null;
      let closest = Number.POSITIVE_INFINITY;

      for (const label of timeline.querySelectorAll(".timeline-year-label")) {
        const box = label.getBoundingClientRect();
        const distance = Math.abs(box.left + box.width / 2 - centerX);
        if (distance < closest) {
          closest = distance;
          current = label.parentElement;
        }
      }

      // 当前列 = 离视口中心最近的卡片年（预告期间亦然，轨迹随之点亮）
      const highlighted = current;

      for (const year of timeline.querySelectorAll(".timeline-year")) {
        if (year === highlighted) {
          year.setAttribute("data-current", "true");
        } else {
          year.removeAttribute("data-current");
        }
      }

      lightTrailUpTo(highlighted as HTMLElement | null);

      // 活动场的 SVG 基线跟随真实轴线，而不是假设轨道永远上下等高。
      const activitySvg = timeline.querySelector<SVGSVGElement>(
        ".timeline-activity-svg"
      );
      const axisDot = timeline.querySelector<HTMLElement>(".timeline-year-dot");
      const baseViewBox = activitySvg?.dataset.baseViewBox;
      if (activitySvg && axisDot && track && baseViewBox) {
        const axisLabel = axisDot.closest<HTMLElement>(".timeline-year-label");
        const transform = axisLabel
          ? window.getComputedStyle(axisLabel).transform
          : "none";
        const alignedViewBox = computeAlignedActivityViewBox(
          baseViewBox,
          track.getBoundingClientRect(),
          axisDot.getBoundingClientRect(),
          parseTranslateY(transform)
        );
        if (alignedViewBox) {
          activitySvg.setAttribute("viewBox", alignedViewBox);
          activitySvg
            .closest<HTMLElement>(".timeline-activity")
            ?.setAttribute("data-aligned", "true");
        }
      }
    };

    // 居中/靠边切换会改变滚动条与可视高度，用 rAF 合并重算，避免状态过期
    let queued = false;
    const scheduleUpdate = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    // 滚动时"升温"：滚动中点亮，停手后冷却
    let heatTimer = 0;

    viewport.addEventListener(
      "scroll",
      () => {
        // 布局相关的更新（含"当前年份"判定）合并到 rAF，避免每个滚动事件都读几何
        scheduleUpdate();
        if (reduceMotion.matches) return;

        timeline.dataset.heat = "true";
        window.clearTimeout(heatTimer);
        heatTimer = window.setTimeout(() => {
          timeline.dataset.heat = "false";
        }, 220);
      },
      { passive: true }
    );
    window.addEventListener("resize", scheduleUpdate);

    // 竖屏看不到时间轴与光带：离开横屏即收掉本轮巡航；回到横屏重新起步
    horizontal.addEventListener("change", () => {
      scheduleUpdate();
      if (!horizontal.matches) {
        endRun();
        return;
      }
      queueFlowRun();
    });

    // 用户接管（滚轮/触摸/拖拽/键盘/焦点进入）后，巡航与光带一起停下
    const haltFlowOnUserInput = () => activeFlowRun?.();
    viewport.addEventListener("wheel", haltFlowOnUserInput, { passive: true });
    viewport.addEventListener("touchstart", haltFlowOnUserInput, {
      passive: true,
    });
    viewport.addEventListener("pointerdown", haltFlowOnUserInput, {
      passive: true,
    });
    viewport.addEventListener("keydown", haltFlowOnUserInput);
    timeline.addEventListener("focusin", haltFlowOnUserInput);

    if (typeof ResizeObserver !== "undefined") {
      const observer = new ResizeObserver(scheduleUpdate);
      observer.observe(viewport);
      if (track) observer.observe(track);
    }

    // document 只挂一次滚轮监听，避免视图切换后重复绑定
    if (document.documentElement.dataset.timelineWheel !== "true") {
      document.documentElement.dataset.timelineWheel = "true";
      document.addEventListener("wheel", handleWheel, { passive: false });
    }

    timeline.dataset.timelineReady = "true";
    scheduleUpdate();
    bindActivityAlignmentRefresh({
      scheduleUpdate,
      windowObject: window,
      documentObject: document,
      requestFrame: (callback: FrameRequestCallback) =>
        requestAnimationFrame(callback),
    });

    // 首页打开即巡航：等入场动画起势后，光带从左边出发
    queueFlowRun();
  }

  const initTimeline = () => setupTimeline();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTimeline, { once: true });
  } else {
    initTimeline();
  }

  document.addEventListener("astro:page-load", initTimeline);
</script>
