---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { useTranslations } from "@/i18n";
import config from "@/config";
import {
  getTagTransitionCss,
  getTagTransitionName,
} from "@/utils/getTagTransitionCss";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getSortedPosts(
      posts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
    );

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName, tag },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName, tag } = Astro.props;
const transitionName = getTagTransitionName(tag);
const tagTransitionCss = getTagTransitionCss([tag]);
const postTransitionNames = page.data.map(post =>
  toTransitionName(post.data.title)
);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}>
  <Fragment slot="head">
    <style is:global set:html={tagTransitionCss}></style>

    <script>
      function setupTagReturnCleanup() {
        if (document.documentElement.dataset.tagReturnCleanupBound === "true") {
          return;
        }

        document.documentElement.dataset.tagReturnCleanupBound = "true";

        const removeStyle = () =>
          document.querySelector("[data-tag-return-cleanup]")?.remove();

        document.addEventListener("astro:before-preparation", event => {
          const list = document.querySelector<HTMLElement>(
            "[data-post-transition-names]"
          );

          if (!list) return;

          const target = new URL(event.to, location.href);
          if (!target.pathname.replace(/\/+$/, "").endsWith("/tags")) return;

          const names = JSON.parse(
            list.dataset.postTransitionNames ?? "[]"
          ) as string[];
          const css = names
            .map(
              name => `
            ::view-transition-old(${name}),
            ::view-transition-new(${name}) {
              animation: none !important;
              opacity: 0 !important;
              mix-blend-mode: normal;
            }
          `
            )
            .join("\n");

          removeStyle();

          const style = document.createElement("style");
          style.dataset.tagReturnCleanup = "true";
          style.textContent = css;
          document.head.append(style);

          window.setTimeout(removeStyle, 600);
        });

        document.addEventListener("astro:page-load", removeStyle);
      }

      const initTagReturnCleanup = () => setupTagReturnCleanup();

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initTagReturnCleanup, {
          once: true,
        });
      } else {
        initTagReturnCleanup();
      }

      document.addEventListener("astro:page-load", initTagReturnCleanup);
    </script>
  </Fragment>

  <Header />

  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={`${t.pages.tagDesc} "${tagName}".`}
    hideHeader
  >
    <p class="tag-detail-path" aria-hidden="true">
      <span
        class="tag-detail-name"
        style={{ viewTransitionName: transitionName }}
      >
        {tagName}
      </span>
    </p>

    <ul data-post-transition-names={JSON.stringify(postTransitionNames)}>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<style>
  .tag-detail-path {
    margin: 2rem 0 1.5rem;
  }

  .tag-detail-name {
    display: inline-block;
    color: var(--color-foreground);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }
</style>
