---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import TagCloud from "@/components/TagCloud.astro";
import { getUniqueTagsWithCounts } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTagsWithCounts(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Main
    hideHeader
    noPadding
    pageTitle={t.pages.tagsTitle}
    pageDesc={t.pages.tagsDesc}
    class="flex min-h-0 flex-1 flex-col"
  >
    <TagCloud {tags} />
  </Main>

  <Footer />
</Layout>
