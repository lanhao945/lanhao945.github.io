---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { postFilter } from "@/utils/postFilter";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });

const posts = await getCollection("posts");
const yearGroups = Object.entries(
  getPostsByGroupCondition(posts.filter(postFilter), post =>
    post.data.pubDatetime.getFullYear()
  )
)
  .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
  .map(([year, yearPosts]) => ({
    year: Number(year),
    count: yearPosts.length,
    months: Object.entries(
      getPostsByGroupCondition(
        yearPosts,
        post => post.data.pubDatetime.getMonth() + 1
      )
    )
      .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
      .map(([month, monthPosts]) => ({
        month: Number(month),
        posts: [...monthPosts].sort(
          (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
        ),
      })),
  }));
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle={t.pages.archivesTitle}
    pageDesc={t.pages.archivesDesc}
    hideHeader
    class="archives-main"
  >
    <div class="archive-timeline">
      {
        yearGroups.map(({ year, count, months }) => (
          <section class="archive-year">
            <h2 class="archive-year-label">
              <span>{year}</span>
              <sup>{count}</sup>
            </h2>

            {months.map(({ month, posts: monthPosts }) => (
              <div class="archive-month">
                <div class="archive-month-label">
                  <time datetime={`${year}-${String(month).padStart(2, "0")}`}>
                    {monthFormatter.format(new Date(2000, month - 1, 1))}
                  </time>
                  <sup>{monthPosts.length}</sup>
                </div>

                <ul class="archive-posts">
                  {monthPosts.map(post => (
                    <li class="archive-post">
                      <a
                        class="archive-post-link"
                        href={getPostUrl(post.id, post.filePath, locale)}
                      >
                        <h3
                          class="archive-post-title"
                          transition:name={toTransitionName(post.data.title)}
                        >
                          {post.data.title}
                        </h3>
                      </a>

                      <div class="archive-post-date">
                        <Datetime
                          pubDatetime={post.data.pubDatetime}
                          modDatetime={post.data.modDatetime}
                          timezone={post.data.timezone}
                        />
                      </div>

                      <p class="archive-post-description">
                        {post.data.description}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  :global(.archives-main) {
    padding-block: 1.5rem 3rem;
  }

  .archive-timeline {
    position: relative;
    margin-top: 1.5rem;
    padding-inline-start: 1.75rem;
  }

  .archive-timeline::before {
    content: "";
    position: absolute;
    inset-block: 0.5rem 0;
    inset-inline-start: 0.45rem;
    width: 1px;
    background: var(--color-border);
  }

  .archive-year {
    position: relative;
    margin-top: 1.75rem;
  }

  .archive-year:first-child {
    margin-top: 0;
  }

  .archive-year-label {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0.65rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .archive-year-label::before {
    content: "";
    position: absolute;
    left: -1.75rem;
    top: 0.55rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-background);
    transform: translate(-50%, -50%);
  }

  .archive-year-label sup {
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
  }

  .archive-month {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    column-gap: 1.25rem;
    padding-block: 0.6rem;
    border-top: 1px dashed var(--color-border);
  }

  .archive-month:first-of-type {
    border-top: 0;
  }

  .archive-month-label {
    position: relative;
    padding-top: 0.1rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .archive-month-label::before {
    content: "";
    position: absolute;
    left: -1.75rem;
    top: 0.55rem;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 9999px;
    background: var(--color-border);
    transform: translate(-50%, -50%);
  }

  .archive-month-label sup {
    margin-inline-start: 0.25rem;
    font-size: 0.7rem;
    color: var(--color-muted-foreground);
  }

  .archive-posts {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-post {
    padding-bottom: 0.55rem;
    border-bottom: 1px dashed var(--color-border);
  }

  .archive-post:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .archive-post-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  .archive-post-link {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .archive-post-link:hover .archive-post-title {
    color: var(--color-accent);
  }

  .archive-post-date {
    margin-top: 0.05rem;
  }

  .archive-post-description {
    margin: 0.1rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 640px) {
    .archive-timeline {
      padding-inline-start: 1.5rem;
    }

    .archive-timeline::before {
      inset-inline-start: 0.4rem;
    }

    .archive-year-label::before,
    .archive-month-label::before {
      left: -1.5rem;
    }

    .archive-month {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .archive-month-label {
      padding-top: 0;
    }

    .archive-month-label::before {
      top: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-post-title {
      transition: none;
    }
  }
</style>
