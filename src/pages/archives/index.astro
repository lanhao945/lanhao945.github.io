---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import {
  ARCHIVE_INITIAL_ITEMS,
  getArchivePosts,
} from "./_utils/getArchiveData";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
const archiveDataBase = getRelativeLocaleUrl(locale, "archives/data").replace(
  /\/$/,
  ""
);

const posts = await getArchivePosts();
const initialCount = Math.min(ARCHIVE_INITIAL_ITEMS, posts.length);
const hasMore = posts.length > initialCount;
const archiveVersion = `${posts.length}-${posts[0]?.id ?? "empty"}-${posts.at(-1)?.id ?? "empty"}`;

const formatDate = (date: Date, timezone?: string) =>
  new Intl.DateTimeFormat("en-CA", {
    timeZone: timezone ?? config.site.timezone,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date);

let postOrder = 0;

const yearGroups = Object.entries(
  getPostsByGroupCondition(posts, post => post.data.pubDatetime.getFullYear())
)
  .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
  .map(([year, yearPosts]) => {
    const months = Object.entries(
      getPostsByGroupCondition(
        yearPosts,
        post => post.data.pubDatetime.getMonth() + 1
      )
    )
      .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
      .map(([month, monthPosts]) => {
        const monthItems = [...monthPosts]
          .sort(
            (a, b) =>
              b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
          )
          .map(post => ({ post, order: postOrder++ }));

        return {
          month: Number(month),
          count: monthItems.length,
          posts: monthItems,
          visibleInitially: monthItems.some(item => item.order < initialCount),
        };
      });

    return {
      year: Number(year),
      count: yearPosts.length,
      months,
      visibleInitially: months.some(month => month.visibleInitially),
    };
  });
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle={t.pages.archivesTitle}
    pageDesc={t.pages.archivesDesc}
    hideHeader
    class="archives-main"
  >
    <div
      class="archive-timeline"
      data-archive-timeline
      data-archive-version={archiveVersion}
      data-archive-next={hasMore ? "1" : ""}
      data-archive-endpoint={archiveDataBase}
    >
      {
        yearGroups.map(({ year, count, months, visibleInitially }) => (
          <section
            class="archive-year"
            data-archive-year
            data-empty={visibleInitially ? "false" : "true"}
          >
            <h2 class="archive-year-label">
              <span>{year}</span>
              <sup>{count}</sup>
            </h2>

            {months.map(
              ({
                month,
                count: monthCount,
                posts: monthPosts,
                visibleInitially: monthVisible,
              }) => (
                <div
                  class="archive-month"
                  data-archive-month
                  data-empty={monthVisible ? "false" : "true"}
                >
                  <div class="archive-month-label">
                    <time
                      datetime={`${year}-${String(month).padStart(2, "0")}`}
                    >
                      {monthFormatter.format(new Date(2000, month - 1, 1))}
                    </time>
                    <sup>{monthCount}</sup>
                  </div>

                  <ul
                    class="archive-posts"
                    data-archive-month-list
                    data-year={year}
                    data-month={month}
                  >
                    {monthPosts
                      .filter(item => item.order < initialCount)
                      .map(({ post }) => (
                        <li class="archive-post" data-archive-key={post.id}>
                          <a
                            class="archive-post-link"
                            href={getPostUrl(post.id, post.filePath, locale)}
                          >
                            <h3
                              class="archive-post-title"
                              transition:name={toTransitionName(
                                post.data.title
                              )}
                            >
                              {post.data.title}
                            </h3>
                          </a>

                          <div class="archive-post-date">
                            <time
                              datetime={post.data.pubDatetime.toISOString()}
                            >
                              {formatDate(
                                post.data.pubDatetime,
                                post.data.timezone
                              )}
                            </time>
                          </div>

                          <p class="archive-post-description">
                            {post.data.description}
                          </p>
                        </li>
                      ))}
                  </ul>
                </div>
              )
            )}
          </section>
        ))
      }

      <div class="archive-sentinel" data-archive-sentinel aria-hidden="true">
      </div>

      <div class="archive-loader" data-archive-loader aria-hidden="true"></div>
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  :global(.archives-main) {
    padding-block: 1.5rem 3rem;
  }

  .archive-timeline {
    position: relative;
    margin-top: 1.5rem;
  }

  .archive-timeline::before {
    content: "";
    position: absolute;
    inset-block: 0.5rem 0;
    inset-inline-start: calc(7rem + 1.5rem);
    width: 1px;
    background: var(--color-border);
  }

  .archive-year[data-empty="true"],
  .archive-month[data-empty="true"] {
    display: none;
  }

  .archive-sentinel {
    block-size: 1px;
  }

  .archive-loader {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    block-size: 3px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .archive-loader::before {
    content: "";
    display: block;
    block-size: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
    transform: translateX(-100%);
  }

  .archive-timeline[data-archive-loading="true"] .archive-loader {
    opacity: 1;
  }

  .archive-timeline[data-archive-loading="true"] .archive-loader::before {
    animation: archive-loader-slide 0.85s linear infinite;
  }

  @keyframes archive-loader-slide {
    to {
      transform: translateX(100%);
    }
  }

  :global(.archive-post-enter) {
    animation: archive-post-enter 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--archive-enter-delay, 0ms);
  }

  @keyframes archive-post-enter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .archive-year {
    position: relative;
    margin-top: 1.75rem;
  }

  .archive-year:first-child {
    margin-top: 0;
  }

  .archive-year-label {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.4rem;
    inline-size: 7rem;
    margin: 0 0 0.65rem;
    white-space: nowrap;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: right;
  }

  .archive-year-label::before {
    content: "";
    position: absolute;
    left: calc(7rem + 1.5rem);
    top: 0.55rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-background);
    transform: translate(-50%, -50%);
  }

  .archive-year-label sup {
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
  }

  .archive-month {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: 3rem;
    padding-block: 0.6rem;
  }

  .archive-month-label {
    position: relative;
    padding-top: 0.1rem;
    padding-inline-end: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-align: right;
  }

  .archive-month-label::before {
    content: "";
    position: absolute;
    left: calc(7rem + 1.5rem);
    top: 0.55rem;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 9999px;
    background: var(--color-border);
    transform: translate(-50%, -50%);
  }

  .archive-month-label sup {
    margin-inline-start: 0.25rem;
    font-size: 0.7rem;
    color: var(--color-muted-foreground);
  }

  .archive-posts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.archive-post) {
    padding-bottom: 0;
  }

  :global(.archive-post-title) {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  :global(.archive-post-link) {
    color: var(--color-foreground);
    text-decoration: none;
  }

  :global(.archive-post-link:hover .archive-post-title) {
    color: var(--color-accent);
  }

  :global(.archive-post-date) {
    margin-top: 0.05rem;
    color: var(--color-muted-foreground);
    font-size: 0.8125rem;
  }

  :global(.archive-post-description) {
    margin: 0.1rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 640px) {
    .archive-timeline {
      padding-inline-start: 1.5rem;
    }

    .archive-timeline::before {
      inset-inline-start: 0.4rem;
    }

    .archive-year-label {
      justify-content: flex-start;
      inline-size: auto;
      text-align: left;
    }

    .archive-year-label::before,
    .archive-month-label::before {
      left: -1.5rem;
    }

    .archive-month {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .archive-month-label {
      padding-top: 0;
      padding-inline-end: 0;
      text-align: left;
    }

    .archive-month-label::before {
      top: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.archive-post-title),
    :global(.archive-post-enter) {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  type ArchivePostPayload = {
    key: string;
    transitionName: string;
    year: number;
    month: number;
    title: string;
    description: string;
    publishedAt: string;
    timezone: string;
    url: string;
  };

  type ArchiveChunkPayload = {
    posts: ArchivePostPayload[];
    next: number | null;
  };

  const formatArchiveDate = (post: ArchivePostPayload) =>
    new Intl.DateTimeFormat("en-CA", {
      timeZone: post.timezone,
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(new Date(post.publishedAt));

  const createArchivePost = (post: ArchivePostPayload, index = 0) => {
    const item = document.createElement("li");
    item.className = "archive-post archive-post-enter";
    item.dataset.archiveKey = post.key;
    item.style.setProperty(
      "--archive-enter-delay",
      `${Math.min(index, 7) * 45}ms`
    );
    item.addEventListener(
      "animationend",
      () => {
        item.classList.remove("archive-post-enter");
        item.style.removeProperty("--archive-enter-delay");
      },
      { once: true }
    );

    const link = document.createElement("a");
    link.className = "archive-post-link";
    link.href = post.url;

    const title = document.createElement("h3");
    title.className = "archive-post-title";
    title.style.viewTransitionName = post.transitionName;
    title.textContent = post.title;
    link.append(title);

    const date = document.createElement("div");
    date.className = "archive-post-date";

    const time = document.createElement("time");
    time.dateTime = post.publishedAt;
    time.textContent = formatArchiveDate(post);
    date.append(time);

    const description = document.createElement("p");
    description.className = "archive-post-description";
    description.textContent = post.description;

    item.append(link, date, description);
    return item;
  };

  function setupArchiveLoading() {
    const root = document.querySelector<HTMLElement>("[data-archive-timeline]");
    if (!root || root.dataset.archiveLoadingReady === "true") return;

    const endpoint = root.dataset.archiveEndpoint;
    const sentinel = root.querySelector<HTMLElement>("[data-archive-sentinel]");
    let next = Number(root.dataset.archiveNext || "0");

    if (!endpoint || !sentinel || !next) return;

    root.dataset.archiveLoadingReady = "true";

    let loading = false;
    let observer: IntersectionObserver | null = null;
    const MIN_LOADING_MS = 320;

    const nearSentinel = () =>
      sentinel.getBoundingClientRect().top <= window.innerHeight + 400;

    const appendPosts = (posts: ArchivePostPayload[]) => {
      const groups = new Map<
        string,
        { year: number; month: number; items: ArchivePostPayload[] }
      >();

      for (const post of posts) {
        const key = `${post.year}-${post.month}`;
        const group = groups.get(key);

        if (group) {
          group.items.push(post);
        } else {
          groups.set(key, {
            year: post.year,
            month: post.month,
            items: [post],
          });
        }
      }

      for (const group of groups.values()) {
        const list = root.querySelector<HTMLElement>(
          `[data-archive-month-list][data-year="${group.year}"][data-month="${group.month}"]`
        );

        if (!list) continue;

        const fragment = document.createDocumentFragment();
        group.items.forEach((post, index) => {
          fragment.append(createArchivePost(post, index));
        });
        list.append(fragment);

        const month = list.closest("[data-archive-month]");
        const year = list.closest("[data-archive-year]");
        if (month instanceof HTMLElement) month.dataset.empty = "false";
        if (year instanceof HTMLElement) year.dataset.empty = "false";
      }
    };

    const cleanup = () => {
      observer?.disconnect();
      window.removeEventListener("scroll", onScroll);
    };

    const loadNext = async () => {
      if (loading || !next) return;
      loading = true;
      const startedAt = performance.now();
      root.dataset.archiveLoading = "true";

      try {
        const response = await fetch(`${endpoint}/${next}.json`, {
          headers: { Accept: "application/json" },
        });

        if (!response.ok) {
          throw new Error(`Archive chunk ${next} failed: ${response.status}`);
        }

        const data = (await response.json()) as ArchiveChunkPayload;
        appendPosts(data.posts);
        next = Number(data.next ?? 0);
        root.dataset.archiveNext = next ? String(next) : "";
      } catch {
        // Keep `next` unchanged so the next scroll/intersection can retry.
      }

      const remaining = MIN_LOADING_MS - (performance.now() - startedAt);
      if (remaining > 0) {
        await new Promise(resolve => window.setTimeout(resolve, remaining));
      }

      root.dataset.archiveLoading = "false";
      loading = false;

      if (!next) {
        cleanup();
      } else if (nearSentinel()) {
        requestAnimationFrame(() => void loadNext());
      }
    };

    function onScroll() {
      if (nearSentinel()) void loadNext();
    }

    if (typeof IntersectionObserver !== "undefined") {
      observer = new IntersectionObserver(
        entries => {
          if (entries.some(entry => entry.isIntersecting)) {
            void loadNext();
          }
        },
        { rootMargin: "400px 0px" }
      );
      observer.observe(sentinel);
    }

    window.addEventListener("scroll", onScroll, { passive: true });

    document.addEventListener("astro:before-swap", cleanup, { once: true });

    if (nearSentinel()) void loadNext();
  }

  const initArchiveLoading = () => setupArchiveLoading();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initArchiveLoading, {
      once: true,
    });
  } else {
    initArchiveLoading();
  }

  document.addEventListener("astro:page-load", initArchiveLoading);
</script>
