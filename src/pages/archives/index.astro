---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { postFilter } from "@/utils/postFilter";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
const INITIAL_ITEMS = 8;

const posts = await getCollection("posts");
let postOrder = 0;

const yearGroups = Object.entries(
  getPostsByGroupCondition(posts.filter(postFilter), post =>
    post.data.pubDatetime.getFullYear()
  )
)
  .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
  .map(([year, yearPosts]) => {
    const months = Object.entries(
      getPostsByGroupCondition(
        yearPosts,
        post => post.data.pubDatetime.getMonth() + 1
      )
    )
      .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
      .map(([month, monthPosts]) => {
        const monthItems = [...monthPosts]
          .sort(
            (a, b) =>
              b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
          )
          .map(post => ({ post, order: postOrder++ }));

        return {
          month: Number(month),
          count: monthItems.length,
          posts: monthItems,
          visibleInitially: monthItems.some(item => item.order < INITIAL_ITEMS),
        };
      });

    return {
      year: Number(year),
      count: yearPosts.length,
      months,
      visibleInitially: months.some(month => month.visibleInitially),
    };
  });
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle={t.pages.archivesTitle}
    pageDesc={t.pages.archivesDesc}
    hideHeader
    class="archives-main"
  >
    <div class="archive-timeline" data-archive-timeline>
      {
        yearGroups.map(({ year, count, months, visibleInitially }) => (
          <section
            class="archive-year"
            data-archive-year
            data-empty={visibleInitially ? "false" : "true"}
          >
            <h2 class="archive-year-label">
              <span>{year}</span>
              <sup>{count}</sup>
            </h2>

            {months.map(
              ({
                month,
                count: monthCount,
                posts: monthPosts,
                visibleInitially: monthVisible,
              }) => (
                <div
                  class="archive-month"
                  data-archive-month
                  data-empty={monthVisible ? "false" : "true"}
                >
                  <div class="archive-month-label">
                    <time
                      datetime={`${year}-${String(month).padStart(2, "0")}`}
                    >
                      {monthFormatter.format(new Date(2000, month - 1, 1))}
                    </time>
                    <sup>{monthCount}</sup>
                  </div>

                  <ul class="archive-posts">
                    {monthPosts.map(({ post, order }) => (
                      <li
                        class="archive-post"
                        data-archive-item
                        data-hidden={order >= INITIAL_ITEMS ? "true" : "false"}
                      >
                        <a
                          class="archive-post-link"
                          href={getPostUrl(post.id, post.filePath, locale)}
                        >
                          <h3
                            class="archive-post-title"
                            transition:name={toTransitionName(post.data.title)}
                          >
                            {post.data.title}
                          </h3>
                        </a>

                        <div class="archive-post-date">
                          <Datetime
                            pubDatetime={post.data.pubDatetime}
                            modDatetime={post.data.modDatetime}
                            timezone={post.data.timezone}
                          />
                        </div>

                        <p class="archive-post-description">
                          {post.data.description}
                        </p>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            )}
          </section>
        ))
      }

      <div class="archive-sentinel" data-archive-sentinel aria-hidden="true">
      </div>
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  :global(.archives-main) {
    padding-block: 1.5rem 3rem;
  }

  .archive-timeline {
    position: relative;
    margin-top: 1.5rem;
  }

  .archive-timeline::before {
    content: "";
    position: absolute;
    inset-block: 0.5rem 0;
    inset-inline-start: calc(6.5rem + 0.625rem);
    width: 1px;
    background: var(--color-border);
  }

  .archive-year[data-empty="true"],
  .archive-month[data-empty="true"],
  .archive-post[data-hidden="true"] {
    display: none;
  }

  .archive-sentinel {
    block-size: 1px;
  }

  .archive-year {
    position: relative;
    margin-top: 1.75rem;
  }

  .archive-year:first-child {
    margin-top: 0;
  }

  .archive-year-label {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    justify-content: flex-end;
    inline-size: 6.5rem;
    margin: 0 0 0.65rem;
    text-align: right;
    white-space: nowrap;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .archive-year-label::before {
    content: "";
    position: absolute;
    left: calc(6.5rem + 0.625rem);
    top: 0.55rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-background);
    transform: translate(-50%, -50%);
  }

  .archive-year-label sup {
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
  }

  .archive-month {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    column-gap: 1.25rem;
    padding-block: 0.6rem;
  }

  .archive-month-label {
    position: relative;
    padding-top: 0.1rem;
    padding-inline-end: 0.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-align: right;
  }

  .archive-month-label::before {
    content: "";
    position: absolute;
    left: calc(6.5rem + 0.625rem);
    top: 0.55rem;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 9999px;
    background: var(--color-border);
    transform: translate(-50%, -50%);
  }

  .archive-month-label sup {
    margin-inline-start: 0.25rem;
    font-size: 0.7rem;
    color: var(--color-muted-foreground);
  }

  .archive-posts {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .archive-post {
    padding-bottom: 0;
  }

  .archive-post-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  .archive-post-link {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .archive-post-link:hover .archive-post-title {
    color: var(--color-accent);
  }

  .archive-post-date {
    margin-top: 0.05rem;
  }

  .archive-post-description {
    margin: 0.1rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 640px) {
    .archive-timeline {
      padding-inline-start: 1.5rem;
    }

    .archive-year-label {
      justify-content: flex-start;
      inline-size: auto;
      text-align: left;
    }

    .archive-timeline::before {
      inset-inline-start: 0.4rem;
    }

    .archive-year-label::before,
    .archive-month-label::before {
      left: -1.5rem;
    }

    .archive-month {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .archive-month-label {
      padding-top: 0;
      padding-inline-end: 0;
      text-align: left;
    }

    .archive-month-label::before {
      top: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-post-title {
      transition: none;
    }
  }
</style>

<script>
  function setupArchiveLoading() {
    const root = document.querySelector<HTMLElement>("[data-archive-timeline]");
    if (!root || root.dataset.archiveReady === "true") return;

    const items = [
      ...root.querySelectorAll<HTMLElement>("[data-archive-item]"),
    ];
    const months = [
      ...root.querySelectorAll<HTMLElement>("[data-archive-month]"),
    ];
    const years = [
      ...root.querySelectorAll<HTMLElement>("[data-archive-year]"),
    ];
    const sentinel = root.querySelector<HTMLElement>("[data-archive-sentinel]");

    let remainingHidden = items.filter(
      item => item.dataset.hidden === "true"
    ).length;

    if (remainingHidden === 0) return;

    root.dataset.archiveReady = "true";

    const updateGroups = () => {
      for (const month of months) {
        const hasVisible = [
          ...month.querySelectorAll<HTMLElement>("[data-archive-item]"),
        ].some(item => item.dataset.hidden !== "true");
        month.dataset.empty = hasVisible ? "false" : "true";
      }

      for (const year of years) {
        const hasVisible = [
          ...year.querySelectorAll<HTMLElement>("[data-archive-month]"),
        ].some(month => month.dataset.empty !== "true");
        year.dataset.empty = hasVisible ? "false" : "true";
      }
    };

    const BATCH = 8;

    const reveal = () => {
      let revealed = 0;

      for (const item of items) {
        if (revealed >= BATCH) break;
        if (item.dataset.hidden === "true") {
          item.dataset.hidden = "false";
          revealed += 1;
          remainingHidden -= 1;
        }
      }

      if (revealed === 0) return;
      updateGroups();

      if (remainingHidden <= 0) {
        observer?.disconnect();
        window.removeEventListener("scroll", onScroll);
      }
    };

    let queued = false;
    const queueReveal = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        reveal();
      });
    };

    const nearBottom = () => {
      const doc = document.documentElement;
      return window.scrollY + doc.clientHeight >= doc.scrollHeight - 500;
    };

    const onScroll = () => {
      if (nearBottom()) queueReveal();
    };

    const observer =
      sentinel && typeof IntersectionObserver !== "undefined"
        ? new IntersectionObserver(
            entries => {
              if (entries.some(entry => entry.isIntersecting)) {
                queueReveal();
              }
            },
            { rootMargin: "500px 0px" }
          )
        : null;

    observer?.observe(sentinel as Element);
    window.addEventListener("scroll", onScroll, { passive: true });

    document.addEventListener(
      "astro:before-swap",
      () => {
        observer?.disconnect();
        window.removeEventListener("scroll", onScroll);
      },
      { once: true }
    );

    updateGroups();
    if (nearBottom()) queueReveal();
  }

  const initArchiveLoading = () => setupArchiveLoading();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initArchiveLoading, {
      once: true,
    });
  } else {
    initArchiveLoading();
  }

  document.addEventListener("astro:page-load", initArchiveLoading);
</script>
