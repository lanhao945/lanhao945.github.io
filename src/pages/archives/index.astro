---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { getArchivePosts } from "./_utils/getArchiveData";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });

const posts = await getArchivePosts();
const archiveVersion = `${posts.length}-${posts[0]?.id ?? "empty"}-${posts.at(-1)?.id ?? "empty"}`;

const titleTransitionNames = [
  ...new Set(posts.map(post => toTransitionName(post.data.title))),
];
const titleTransitionCss = titleTransitionNames
  .map(
    name => `
      ::view-transition-group(${name}) {
        animation-duration: 260ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      }
      ::view-transition-old(${name}) {
        animation: none !important;
        opacity: 0 !important;
        mix-blend-mode: normal;
      }
      ::view-transition-new(${name}) {
        animation: none !important;
        opacity: 1 !important;
        mix-blend-mode: normal;
      }
    `
  )
  .join("\n");

const formatDate = (date: Date, timezone?: string) =>
  new Intl.DateTimeFormat("en-CA", {
    timeZone: timezone ?? config.site.timezone,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date);

const yearGroups = Object.entries(
  getPostsByGroupCondition(posts, post => post.data.pubDatetime.getFullYear())
)
  .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
  .map(([year, yearPosts]) => {
    const months = Object.entries(
      getPostsByGroupCondition(
        yearPosts,
        post => post.data.pubDatetime.getMonth() + 1
      )
    )
      .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
      .map(([month, monthPosts]) => ({
        month: Number(month),
        count: monthPosts.length,
        posts: [...monthPosts].sort(
          (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
        ),
      }));

    return {
      year: Number(year),
      count: yearPosts.length,
      months,
    };
  });
---

<Layout
  title={`${t.pages.archivesTitle} | ${config.site.title}`}
  bodyClass="archive-page"
>
  <Fragment slot="head">
    <style is:global set:html={titleTransitionCss}></style>
  </Fragment>

  <Header />

  <Main
    pageTitle={t.pages.archivesTitle}
    pageDesc={t.pages.archivesDesc}
    hideHeader
    class="archives-main"
  >
    <div
      class="archive-timeline"
      data-archive-timeline
      data-archive-version={archiveVersion}
    >
      {
        yearGroups.map(({ year, count, months }) => (
          <section class="archive-year" data-archive-year>
            <h2 class="archive-year-label">
              <span>{year}</span>
              <sup>{count}</sup>
            </h2>

            {months.map(({ month, count: monthCount, posts: monthPosts }) => (
              <div class="archive-month" data-archive-month>
                <div class="archive-month-label">
                  <time datetime={`${year}-${String(month).padStart(2, "0")}`}>
                    {monthFormatter.format(new Date(2000, month - 1, 1))}
                  </time>
                  <sup>{monthCount}</sup>
                </div>

                <ul
                  class="archive-posts"
                  data-archive-month-list
                  data-year={year}
                  data-month={month}
                >
                  {monthPosts.map(post => (
                    <li class="archive-post" data-archive-key={post.id}>
                      <a
                        class="archive-post-link"
                        href={getPostUrl(post.id, post.filePath, locale)}
                      >
                        <h3
                          class="archive-post-title"
                          transition:name={toTransitionName(post.data.title)}
                        >
                          {post.data.title}
                        </h3>
                      </a>

                      <div class="archive-post-date">
                        <time datetime={post.data.pubDatetime.toISOString()}>
                          {formatDate(
                            post.data.pubDatetime,
                            post.data.timezone
                          )}
                        </time>
                      </div>

                      <p class="archive-post-description">
                        {post.data.description}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))
      }
    </div>
  </Main>

  <aside
    class="archive-scrollbar"
    data-archive-scrollbar
    aria-label="归档时间轴定位"
  >
    <div class="archive-scrollbar-track" data-archive-scrollbar-track>
      {
        posts.map((post, index) => (
          <button
            type="button"
            class="archive-scrollbar-tick"
            data-archive-scrollbar-tick
            data-index={index}
            data-url={getPostUrl(post.id, post.filePath, locale)}
            data-date={formatDate(post.data.pubDatetime, post.data.timezone)}
            data-title={post.data.title}
            data-description={post.data.description}
            aria-label={`第 ${index + 1} 篇：${post.data.title}`}
            tabindex="-1"
          />
        ))
      }
    </div>

    <a
      class="archive-scrollbar-preview"
      data-archive-scrollbar-preview
      href="#"
    >
      <time
        class="archive-scrollbar-preview-date"
        data-archive-scrollbar-preview-date></time>
      <span
        class="archive-scrollbar-preview-title"
        data-archive-scrollbar-preview-title></span>
      <span
        class="archive-scrollbar-preview-description"
        data-archive-scrollbar-preview-description></span>
    </a>
  </aside>
  <Footer />
</Layout>

<style>
  :global(.archives-main) {
    padding-block: 1.5rem 3rem;
  }

  .archive-timeline {
    position: relative;
    margin-top: 1.5rem;
  }

  .archive-timeline::before {
    content: "";
    position: absolute;
    inset-block: 0.5rem 0;
    inset-inline-start: calc(8rem + 1.75rem);
    width: 1px;
    background: var(--color-border);
  }

  .archive-year {
    position: relative;
    margin-top: 1.75rem;
  }

  .archive-year:first-child {
    margin-top: 0;
  }

  .archive-year-label {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.4rem;
    inline-size: 8rem;
    margin: 0 0 0.65rem;
    white-space: nowrap;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: right;
  }

  .archive-year-label::before {
    content: "";
    position: absolute;
    left: calc(8rem + 1.75rem);
    top: 0.55rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-background);
    transform: translate(-50%, -50%);
  }

  .archive-year-label sup {
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
  }

  .archive-month {
    position: relative;
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    column-gap: 3.5rem;
    padding-block: 0.6rem;
  }

  .archive-month-label {
    position: relative;
    padding-top: 0.1rem;
    padding-inline-end: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-align: right;
  }

  .archive-month-label::before {
    content: "";
    position: absolute;
    left: calc(8rem + 1.75rem);
    top: 0.55rem;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 9999px;
    background: var(--color-border);
    transform: translate(-50%, -50%);
  }

  .archive-month-label sup {
    margin-inline-start: 0.25rem;
    font-size: 0.7rem;
    color: var(--color-muted-foreground);
  }

  .archive-posts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.archive-post) {
    padding-bottom: 0;
  }

  :global(.archive-post-title) {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  :global(.archive-post-link) {
    color: var(--color-foreground);
    text-decoration: none;
  }

  :global(.archive-post-link:hover .archive-post-title) {
    color: var(--color-accent);
  }

  :global(.archive-post-date) {
    margin-top: 0.05rem;
    color: var(--color-muted-foreground);
    font-size: 0.8125rem;
  }

  :global(.archive-post-description) {
    margin: 0.1rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 640px) {
    .archive-timeline {
      padding-inline-start: 1.5rem;
    }

    .archive-timeline::before {
      inset-inline-start: 0.4rem;
    }

    .archive-year-label {
      justify-content: flex-start;
      inline-size: auto;
      text-align: left;
    }

    .archive-year-label::before,
    .archive-month-label::before {
      left: -1.5rem;
    }

    .archive-month {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .archive-month-label {
      padding-top: 0;
      padding-inline-end: 0;
      text-align: left;
    }

    .archive-month-label::before {
      top: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.archive-post-title) {
      transition: none;
    }
  }
  @media (min-width: 1101px) {
    :global(html:has(body.archive-page)) {
      scrollbar-width: none;
    }

    :global(html:has(body.archive-page)::-webkit-scrollbar) {
      display: none;
    }
  }

  .archive-scrollbar {
    position: fixed;
    left: clamp(1.25rem, 2.5vw, 2.5rem);
    top: 50%;
    z-index: 40;
    display: flex;
    align-items: center;
    block-size: min(66vh, 42rem);
    inline-size: 2.75rem;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .archive-scrollbar-track {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    inline-size: 2.25rem;
    block-size: 100%;
    pointer-events: auto;
    cursor: pointer;
    touch-action: none;
  }

  .archive-scrollbar-tick {
    display: block;
    flex: none;
    inline-size: var(--tick-width, 0.5rem);
    block-size: var(--tick-thickness, 1px);
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: var(--color-accent);
    opacity: var(--tick-opacity, 0.55);
    transition:
      inline-size 0.16s ease,
      block-size 0.16s ease,
      opacity 0.16s ease;
  }

  .archive-scrollbar-preview {
    position: absolute;
    left: 2.5rem;
    top: 0;
    display: grid;
    gap: 0.15rem;
    inline-size: min(22rem, 60vw);
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-background);
    box-shadow: 0 8px 24px
      color-mix(in srgb, var(--color-foreground) 12%, transparent);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) translateX(-0.25rem);
    text-decoration: none;
    transition:
      opacity 0.14s ease,
      transform 0.14s ease;
  }

  .archive-scrollbar[data-preview="true"] .archive-scrollbar-preview {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(-50%) translateX(0);
  }

  .archive-scrollbar-preview-date {
    font-size: 0.7rem;
    color: var(--color-muted-foreground);
  }

  .archive-scrollbar-preview-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .archive-scrollbar-preview-description {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--color-muted-foreground);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 1100px) {
    .archive-scrollbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .archive-scrollbar-tick,
    .archive-scrollbar-preview {
      transition: none;
    }
  }
</style>

<script>
  function setupArchiveScrollbar() {
    const root = document.querySelector<HTMLElement>(
      "[data-archive-scrollbar]"
    );
    if (!root || root.dataset.ready === "true") return;

    const track = root.querySelector<HTMLElement>(
      "[data-archive-scrollbar-track]"
    );
    const preview = root.querySelector<HTMLAnchorElement>(
      "[data-archive-scrollbar-preview]"
    );
    const previewDate = root.querySelector<HTMLElement>(
      "[data-archive-scrollbar-preview-date]"
    );
    const previewTitle = root.querySelector<HTMLElement>(
      "[data-archive-scrollbar-preview-title]"
    );
    const previewDescription = root.querySelector<HTMLElement>(
      "[data-archive-scrollbar-preview-description]"
    );
    const ticks = [
      ...root.querySelectorAll<HTMLElement>("[data-archive-scrollbar-tick]"),
    ];
    const posts = [
      ...document.querySelectorAll<HTMLElement>("[data-archive-key]"),
    ];

    if (
      !track ||
      !preview ||
      !previewDate ||
      !previewTitle ||
      !previewDescription ||
      ticks.length === 0
    ) {
      return;
    }

    root.dataset.ready = "true";

    let frame = 0;
    let activePosition = 0;
    let hoverPosition: number | null = null;
    let dragging = false;

    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));

    const scrollInstant = (top: number) => {
      const html = document.documentElement;
      const previous = html.style.scrollBehavior;
      html.style.scrollBehavior = "auto";
      window.scrollTo(0, Math.max(0, top));
      requestAnimationFrame(() => {
        html.style.scrollBehavior = previous;
      });
    };

    const maxScroll = () =>
      Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

    const WAVE_SIGMA = 2.1;

    const applyWave = (focusPosition: number) => {
      ticks.forEach((tick, index) => {
        const distance = index - focusPosition;
        const strength = Math.exp(
          -(distance * distance) / (2 * WAVE_SIGMA * WAVE_SIGMA)
        );
        const width = 0.5 + 1.1 * strength;
        const thickness = 1 + 2.2 * strength;
        const opacity = 0.45 + 0.55 * strength;

        tick.style.setProperty("--tick-width", `${width.toFixed(3)}rem`);
        tick.style.setProperty("--tick-thickness", `${thickness.toFixed(3)}px`);
        tick.style.setProperty("--tick-opacity", opacity.toFixed(3));
      });
    };

    const update = () => {
      const max = maxScroll();
      const progress = max > 0 ? clamp(window.scrollY / max, 0, 1) : 0;

      activePosition = progress * (ticks.length - 1);

      if (hoverPosition === null && !dragging) {
        applyWave(activePosition);
      }
    };

    const scheduleUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };

    const positionFromClientY = (clientY: number) => {
      const rect = track.getBoundingClientRect();
      if (rect.height <= 0) return 0;

      const ratio = clamp((clientY - rect.top) / rect.height, 0, 1);
      return ratio * (ticks.length - 1);
    };

    const scrollFromClientY = (clientY: number) => {
      const rect = track.getBoundingClientRect();
      if (rect.height <= 0) return;

      const ratio = clamp((clientY - rect.top) / rect.height, 0, 1);
      scrollInstant(ratio * maxScroll());
      scheduleUpdate();
    };

    const showPreview = (index: number) => {
      const safeIndex = Math.min(
        ticks.length - 1,
        Math.max(0, Math.round(index))
      );
      const tick = ticks[safeIndex];
      if (!tick) return;

      const rootRect = root.getBoundingClientRect();
      const tickRect = tick.getBoundingClientRect();

      preview.href = tick.dataset.url ?? "#";
      previewDate.textContent = tick.dataset.date ?? "";
      previewTitle.textContent = tick.dataset.title ?? "";
      previewDescription.textContent = tick.dataset.description ?? "";
      preview.style.top = `${tickRect.top - rootRect.top + tickRect.height / 2}px`;
      root.dataset.preview = "true";
    };

    const hidePreview = () => {
      root.dataset.preview = "false";
    };

    track.addEventListener("pointerdown", event => {
      dragging = true;
      track.setPointerCapture(event.pointerId);
      hidePreview();
      scrollFromClientY(event.clientY);
    });

    track.addEventListener("pointermove", event => {
      if (dragging) {
        scrollFromClientY(event.clientY);
        return;
      }

      const position = positionFromClientY(event.clientY);
      hoverPosition = position;
      applyWave(position);
      showPreview(position);
    });

    track.addEventListener("pointerup", event => {
      dragging = false;
      try {
        track.releasePointerCapture(event.pointerId);
      } catch {
        // Pointer capture may already be released.
      }

      const position = positionFromClientY(event.clientY);
      hoverPosition = position;
      applyWave(position);
      showPreview(position);
    });

    track.addEventListener("pointercancel", () => {
      dragging = false;
    });

    root.addEventListener("pointerleave", () => {
      hoverPosition = null;
      hidePreview();
      applyWave(activePosition);
    });

    ticks.forEach((tick, index) => {
      tick.addEventListener("click", () => {
        const post = posts[index];
        if (!post) return;

        const top = post.getBoundingClientRect().top + window.scrollY - 16;
        scrollInstant(top);
        scheduleUpdate();
      });
    });

    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);

    const cleanup = () => {
      cancelAnimationFrame(frame);
      window.removeEventListener("scroll", scheduleUpdate);
      window.removeEventListener("resize", scheduleUpdate);
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });

    update();
    applyWave(activePosition);
  }

  const initArchiveScrollbar = () => setupArchiveScrollbar();

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initArchiveScrollbar, {
      once: true,
    });
  } else {
    initArchiveScrollbar();
  }

  document.addEventListener("astro:page-load", initArchiveScrollbar);
</script>
