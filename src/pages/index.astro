---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Timeline from "@/components/Timeline.astro";
import {
  buildTimelineColumns,
  getSortedTimeline,
  groupTimelineByYear,
} from "@/utils/getSortedTimeline";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const timelineEntries = await getCollection("timeline");
const timelineColumns = buildTimelineColumns(
  groupTimelineByYear(getSortedTimeline(timelineEntries))
);

const homePath = getRelativeLocaleUrl(locale, "");
const postsPath = getRelativeLocaleUrl(locale, "posts");
const rssPath = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`;
---

<Layout bodyClass="home">
  <Header />
  <main id="main-content" data-layout="index" data-home-path={homePath}>
    <section id="hero" class="app-layout border-border border-b pt-10 pb-8">
      <h1 class="text-3xl font-bold tracking-wide sm:text-5xl">兰昊</h1>
      <p class="mt-4 max-w-prose text-sm leading-7 sm:text-base">
        这里按年份记下一些关键节点；零散的想法和记录放在
        <LinkButton
          href={postsPath}
          class="hover:text-accent underline decoration-dashed underline-offset-4"
        >
          {t.nav.posts}
        </LinkButton>。
      </p>
      {
        socials.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="text-muted-foreground text-sm">
              {t.home.socialLinks}
            </span>
            <Socials />
            <a
              href={rssPath}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent text-muted-foreground p-1"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss width={20} height={20} class="stroke-current stroke-2" />
            </a>
          </div>
        )
      }
    </section>

    <Timeline columns={timelineColumns} />
  </main>
  <Footer />
</Layout>

<style>
  /*
   * 宽屏横屏时首页占满整屏：页面本身不滚动，
   * 时间轴区域占满剩余高度，用滚轮/触控板左右浏览。
   */
  @media (min-width: 900px) and (orientation: landscape) {
    :global(html:has(body.home)) {
      overflow-y: hidden;
    }

    :global(body.home) {
      block-size: 100svh;
      overflow: hidden;
    }

    :global(body.home) #main-content {
      display: flex;
      flex: 1;
      min-block-size: 0;
      flex-direction: column;
    }

    /* 简介压成一行（名字 | 一句话 | 联系方式），把高度留给时间轴 */
    #hero {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding-block: 0.75rem;
    }

    #hero h1 {
      flex: none;
      font-size: 1.5rem;
      line-height: 1.3;
    }

    #hero p {
      flex: 1;
      margin: 0;
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    #hero > div {
      flex: none;
      margin: 0;
    }

    /* 头部与页脚也压扁，把高度让给时间轴（属于子组件，需要整段 global） */
    :global(body.home header > div) {
      padding-block: 0.5rem;
    }

    :global(body.home footer > div) {
      padding-block: 0.5rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
