---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Timeline from "@/components/Timeline.astro";
import {
  getSortedTimeline,
  groupTimelineByYear,
} from "@/utils/getSortedTimeline";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const timelineEntries = await getCollection("timeline");
const timelineGroups = groupTimelineByYear(getSortedTimeline(timelineEntries));

const homePath = getRelativeLocaleUrl(locale, "");
const postsPath = getRelativeLocaleUrl(locale, "posts");
const rssPath = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`;
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" data-home-path={homePath}>
    <section id="hero" class="app-layout border-border border-b pt-10 pb-8">
      <h1 class="text-3xl font-bold tracking-wide sm:text-5xl">兰昊</h1>
      <p class="mt-4 max-w-prose text-sm leading-7 sm:text-base">
        这里按年份记下一些关键节点；零散的想法和记录放在
        <LinkButton
          href={postsPath}
          class="hover:text-accent underline decoration-dashed underline-offset-4"
        >
          {t.nav.posts}
        </LinkButton>。
      </p>
      {
        socials.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="text-muted-foreground text-sm">
              {t.home.socialLinks}
            </span>
            <Socials />
            <a
              href={rssPath}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent text-muted-foreground p-1"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss width={20} height={20} class="stroke-current stroke-2" />
            </a>
          </div>
        )
      }
    </section>

    <Timeline groups={timelineGroups} />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
