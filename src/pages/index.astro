---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Timeline from "@/components/Timeline.astro";
import {
  buildTimelineColumns,
  getSortedTimeline,
  groupTimelineByYear,
} from "@/utils/getSortedTimeline";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const timelineEntries = await getCollection("timeline");
const timelineColumns = buildTimelineColumns(
  groupTimelineByYear(getSortedTimeline(timelineEntries))
);

const homePath = getRelativeLocaleUrl(locale, "");
const rssPath = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`;
---

<Layout bodyClass="home">
  <Header />
  <main id="main-content" data-layout="index" data-home-path={homePath}>
    <section id="hero" class="app-layout border-border border-b py-4">
      <h1 class="sr-only">{config.site.title}</h1>
      {
        socials.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="text-muted-foreground text-sm">
              {t.home.socialLinks}
            </span>
            <Socials />
            <a
              href={rssPath}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent text-muted-foreground p-1"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss width={20} height={20} class="stroke-current stroke-2" />
            </a>
          </div>
        )
      }
    </section>

    <Timeline columns={timelineColumns} />
  </main>
  <Footer />
</Layout>

<style>
  /*
   * 宽屏横屏时首页占满整屏：页面本身不滚动，
   * 时间轴区域占满剩余高度，用滚轮/触控板左右浏览。
   */
  @media (min-width: 900px) and (orientation: landscape) {
    :global(html:has(body.home)) {
      overflow-y: hidden;
    }

    :global(body.home) {
      block-size: 100svh;
      overflow: hidden;
    }

    :global(body.home) #main-content {
      display: flex;
      flex: 1;
      min-block-size: 0;
      flex-direction: column;
    }

    /* 顶部只留一行联系方式，把高度让给时间轴 */
    #hero {
      padding-block: 0.5rem;
    }

    /* 头部与页脚也压扁，把高度让给时间轴（属于子组件，需要整段 global） */
    :global(body.home header > div) {
      padding-block: 0.5rem;
    }

    :global(body.home footer > div) {
      padding-block: 0.5rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
